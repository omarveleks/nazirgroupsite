---
import Base from '../layouts/Base.astro';
import Presence from '../components/Presence.astro';
import Statement from '../components/Statement.astro';
import { countries, company, stats } from '../lib/data';
import { worldMap } from '../lib/geo';
import { numberWord } from '../lib/site';

const m = worldMap(countries.map((c) => c.slug).concat('united-kingdom'));
const info = Object.fromEntries(countries.map((c) => [c.slug, c]));
// label offsets to keep markers readable
const OFF: Record<string, [number, number, string]> = {
  pakistan: [14, 5, 'start'],
  'saudi-arabia': [-14, 22, 'end'],
  libya: [-14, 5, 'end'],
  iraq: [0, -16, 'middle'],
  iran: [14, -10, 'start'],
  malaysia: [0, -18, 'middle'],
  mozambique: [14, 5, 'start'],
  'united-kingdom': [14, 5, 'start'],
};
const branches = company.historic_branches.map((b) => (b === 'United Kingdom' ? 'the United Kingdom' : b));
---
<Base
  title="Global presence"
  description={`Nazir and Company across ${numberWord(stats.countries).toLowerCase()} countries in Asia, the Middle East and Africa: ${countries.map((c) => c.name).join(', ')}. Headquarters in Lahore.`}
>
  <header class="page-head w">
    <span class="eb">Global Presence</span>
    <h1 class="h h--xl">{numberWord(stats.countries)} Countries, Three Regions</h1>
    <p class="lede">Headquartered in Lahore, Nazir and Company has delivered across Asia, the Middle East and Africa.</p>
  </header>

  <section class="sec--tight">
    <div class="w">
      <figure class="wmap">
        <svg viewBox={`0 0 ${m.w} ${m.h}`} width={m.w} height={m.h} role="img" aria-labelledby="wm-t wm-d">
          <title id="wm-t">Map from the United Kingdom to Malaysia and Mozambique marking the countries where Nazir and Company has delivered projects</title>
          <desc id="wm-d">{countries.map((c) => c.name).join(', ')}. United Kingdom: historic branch office.</desc>
          <path d={m.base} fill="#f5f6f8" stroke="#cfd5dc" stroke-width="0.6" />
          {m.hi.map((h) => (
            <path d={h.d} fill={h.slug === 'united-kingdom' ? '#f5f6f8' : '#e7eefb'} stroke="#1f4fb8" stroke-width="1" />
          ))}
          <g font-family="Inter Tight, Inter Tight Fallback, Arial, sans-serif" font-size="16" fill="#0b1b2e">
            {m.points.map((p) => {
              const c = info[p.slug];
              const [dx, dy, anchor] = OFF[p.slug] ?? [12, 4, 'start'];
              return (
                <g>
                  <circle cx={p.x} cy={p.y} r={c ? 7 : 5} fill={c ? '#1f4fb8' : '#ffffff'} stroke="#1f4fb8" stroke-width="1.5" />
                  <text x={p.x + dx} y={p.y + dy} text-anchor={anchor} font-weight="400">
                    {c ? c.name : 'UK (branch)'}
                  </text>
                </g>
              );
            })}
          </g>
        </svg>
        <figcaption>Country outlines: Natural Earth.</figcaption>
      </figure>
    </div>
  </section>

  <section class="sec sec--soft" aria-labelledby="countries-h">
    <div class="w">
      <h2 class="visually-hidden" id="countries-h">Countries</h2>
      <Presence />
      <p class="body-grey branches">
        The company has also held branch offices in {branches.slice(0, -1).join(', ')} and {branches.at(-1)}.
      </p>
    </div>
  </section>

  <Statement text="Discuss transmission, substation and infrastructure programmes with the business development team." link={{ href: '/contact/?type=partnership', label: 'Contact' }}>
    Partner With Nazir and Company
  </Statement>
</Base>

<style>
  .wmap {
    margin: 0;
  }
  .wmap svg {
    display: block;
    width: 100%;
    height: auto;
  }
  .wmap figcaption {
    margin-top: 1rem;
    font-size: 0.8125rem;
    color: var(--grey);
  }
  .branches {
    margin-top: 2.5rem;
  }
</style>
