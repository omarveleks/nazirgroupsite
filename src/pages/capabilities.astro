---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Statement from '../components/Statement.astro';
import PecFields from '../components/PecFields.astro';
import Img from '../components/Img.astro';
import { company } from '../lib/data';
import { CAPABILITIES } from '../lib/site';

---
<Base
  title="Capabilities"
  description="Capabilities of Nazir and Company: power transmission, substations, distribution and industrial power, civil infrastructure and telecommunications. Registered with the Pakistan Engineering Council, Licence No. 1."
  heroPhoto="transmission-towers"
>
  <PageHero
    photo="transmission-towers"
    eyebrow="Capabilities"
    lede="From foundations and tower erection to stringing and turnkey lines, delivered by the company’s own teams."
  >
    <Fragment slot="title">Built to Deliver at National Scale</Fragment>
  </PageHero>

  <section class="sec" aria-labelledby="caps-h">
    <div class="w">
      <div class="grid2 head-row">
        <div>
          <span class="eb">What the Company Delivers</span>
          <h2 class="h" id="caps-h">Five Capabilities</h2>
        </div>
        <p class="body-grey">Each capability is backed by projects in the company’s record. Select one for the services and projects behind it.</p>
      </div>
      <ol class="rows">
        {CAPABILITIES.map((c, i) => (
          <li>
            <a href={c.href}>
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{c.title}</h3>
                <p>{c.text}</p>
              </div>
              <span class="go-i"><Icon name="right" /></span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>


  <section class="sec sec--soft" id="licence" aria-labelledby="licence-h">
    <div class="w">
      <div class="grid2 head-row">
        <div>
          <span class="eb">Pakistan Engineering Council, Licence No. 1</span>
          <h2 class="h" id="licence-h">Licensed Across Four Disciplines</h2>
        </div>
        <p class="body-grey">The company's licence covers electrical, civil, mechanical and building works.</p>
      </div>
      <PecFields />
    </div>
  </section>

  <section class="sec" aria-labelledby="strength-h">
    <div class="w duo">
      <div class="duo-t">
        <span class="eb">Engineering and Mobilisation</span>
        <h2 class="h" id="strength-h">Equipped for Every Project</h2>
        <p class="lede">{company.engineering_strength.lede}</p>
        <p class="body-grey">The company has access to a large fleet of construction and stringing equipment, and can mobilise it per project. Further documents are available on request.</p>
      </div>
      <div class="duo-p"><Img name="site-engineer" alt="Site engineer supervising construction" sizes="(min-width: 60em) 50vw, 100vw" /></div>
    </div>
  </section>

  <Statement text="Discuss transmission, substation and infrastructure programmes with the business development team." link={{ href: '/contact/?type=partnership', label: 'Contact' }}>
    Partner With Nazir and Company
  </Statement>
</Base>

<style>
  .top {
    align-items: start;
  }
  .reg-l {
    margin-top: 2rem;
  }
  .regs--stack {
    flex-direction: column;
    margin-top: 0;
    font-size: 1.1875rem;
  }
  .regs--stack li {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line-strong);
  }
  .fin {
    margin-top: 2rem;
  }
  .fields {
    margin-top: 2.25rem;
  }
</style>
