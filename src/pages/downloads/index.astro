---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { projectListPdf, capabilityPdf } from '../../lib/pdf';
import { companyProfilePdf } from '../../lib/profile-pdf';

const kb = (b: Uint8Array) => `${Math.max(1, Math.round(b.byteLength / 1024))} KB`;
const list = await projectListPdf();
const cap = await capabilityPdf();
const profile = await companyProfilePdf();
const docs = [
  {
    title: 'Company Profile',
    text: 'Heritage, leadership, services, selected projects, Libya, global presence and registration.',
    href: '/downloads/nazir-company-profile.pdf',
    size: kb(profile),
  },
  {
    title: 'Capability Statement',
    text: 'One page: registration, services, key figures and selected projects.',
    href: '/downloads/nazir-capability-statement.pdf',
    size: kb(cap),
  },
  {
    title: 'Project List',
    text: 'Every project by country, with client, year, voltage and length.',
    href: '/downloads/nazir-project-list.pdf',
    size: kb(list),
  },
];
---
<Base title="Downloads" description="Download the Nazir and Company company profile, one-page capability statement and project list, prepared for clients, main contractors and partners.">
  <header class="page-head w">
    <span class="eb">Downloads</span>
    <h1 class="h h--xl">Company Documents</h1>
    <p class="lede">The company profile, capability statement and project list, prepared for clients, main contractors and partners.</p>
  </header>

  <section class="sec--tight">
    <div class="w">
      <ul class="docs">
        {docs.map((d) => (
          <li>
            <div>
              <h2>{d.title}</h2>
              <p>{d.text}</p>
            </div>
            <a class="pill" href={d.href} download>Download PDF <span class="size">({d.size})</span> <Icon name="download" /></a>
          </li>
        ))}
      </ul>
      <p class="body-grey more">Further documents are available on request. <a href="/contact/">Contact</a>.</p>
    </div>
  </section>
</Base>

<style>
  .more {
    margin-top: 2.5rem;
  }
</style>
