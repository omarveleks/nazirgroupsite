---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import fs from 'node:fs';
import path from 'node:path';

// The PDFs are rendered from the /print/ pages by scripts/make-pdfs.mjs (npm run pdfs)
const kb = (file: string) => {
  const f = path.join(process.cwd(), 'public', 'downloads', file);
  if (!fs.existsSync(f)) return '';
  const k = Math.round(fs.statSync(f).size / 1024);
  return k >= 1024 ? `${(k / 1024).toFixed(1)} MB` : `${k} KB`;
};
const docs = [
  {
    title: 'Company Profile',
    text: 'Eighteen pages: heritage, leadership, capabilities, services, featured projects, Libya, global presence, clients and registration.',
    href: '/downloads/nazir-company-profile.pdf',
    size: kb('nazir-company-profile.pdf'),
  },
  {
    title: 'Capability Statement',
    text: 'One page: registration, services, key figures and selected projects.',
    href: '/downloads/nazir-capability-statement.pdf',
    size: kb('nazir-capability-statement.pdf'),
  },
  {
    title: 'Project List',
    text: 'Every project by country, with client, sector, voltage and length.',
    href: '/downloads/nazir-project-list.pdf',
    size: kb('nazir-project-list.pdf'),
  },
];
---
<Base title="Downloads" description="Download the Nazir and Company company profile, one-page capability statement and project list, prepared for clients, main contractors and partners.">
  <header class="page-head w">
    <span class="eb">Downloads</span>
    <h1 class="h h--xl">Company Documents</h1>
    <p class="lede">The company profile, capability statement and project list, prepared for clients, main contractors and partners.</p>
  </header>

  <section class="sec--tight">
    <div class="w">
      <ul class="docs">
        {docs.map((d) => (
          <li>
            <div>
              <h2>{d.title}</h2>
              <p>{d.text}</p>
            </div>
            <a class="pill" href={d.href} download>Download PDF {d.size && <span class="size">({d.size})</span>} <Icon name="download" /></a>
          </li>
        ))}
      </ul>
      <p class="body-grey more">Further documents are available on request. <a href="/contact/">Contact</a>.</p>
    </div>
  </section>
</Base>

<style>
  .more {
    margin-top: 2.5rem;
  }
</style>
