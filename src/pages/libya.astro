---
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import Img from '../components/Img.astro';
import Go from '../components/Go.astro';
import More from '../components/More.astro';
import Track from '../components/Track.astro';
import Icon from '../components/Icon.astro';
import { company, country, clientsFor } from '../lib/data';
import { LIBYA_FEATURED } from '../lib/site';

const lib = country('libya');
const clients = clientsFor(lib.projects);
---
<Base
  title="Transmission Line Contractor in Libya"
  description="Nazir and Company in Libya: high-voltage transmission from the coast into the Fezzan, and electrical systems for the country's leading oil producers. Working with main contractors on electrical scope."
  heroPhoto="desert-lines"
>
  <Band photo="desert-lines" alt="High-voltage transmission lines crossing the desert" level="h1" eyebrow="Libya" priority>
    <Fragment slot="title">Experience in <span class="accent">Libya</span></Fragment>
    <p>
      For over three decades, Nazir and Company built high-voltage lines from Tripoli to Benghazi and deep into the Fezzan, and electrical systems for the country’s leading oil producers. {company.libya_status}
    </p>
    <div class="row-links">
      <Go href="/contact/?type=subcontract&country=Libya" label="Libya Subcontract Enquiry" />
    </div>
  </Band>

  <section class="sec lined" aria-labelledby="story-h">
    <div class="w duo">
      <div class="duo-t">
        <span class="eb">The Record</span>
        <h2 class="h" id="story-h">From the Coast to the Fezzan</h2>
        <p class="lede">
          Nazir and Company built transmission along the coast from Misurata to Sirte and around Tripoli, a turnkey line from Benghazi to the eastern border, and lines south through Hun to Sebha in the Fezzan.
        </p>
        <p class="body-grey">
          For the Arabian Gulf Oil, Sirte Oil and Waha Oil companies, the company electrified wells, laid underground cables, built overhead lines and substations in the oil fields, and maintained a live line in service.
        </p>
        <div class="row-links"><More href="/projects/libya/" label="All Libyan Projects" /></div>
      </div>
      <div class="duo-p"><Img name="tower-mono" alt="Lattice transmission tower and conductors" sizes="(min-width: 60em) 50vw, 100vw" /></div>
    </div>
  </section>

  <section class="sec--tight" aria-labelledby="flag-h">
    <div class="w grid2 head-row">
      <div>
        <span class="eb">Featured Projects</span>
        <h2 class="h" id="flag-h">Key Lines in Libya</h2>
      </div>
      <p class="body-grey">Transmission for the national utility and power for the oil fields.</p>
    </div>
    <Track items={LIBYA_FEATURED} label="Featured projects in Libya" />
  </section>

  <section class="sec lined" aria-labelledby="mc-h">
    <div class="w duo duo--flip">
      <div class="duo-t">
        <span class="eb">Working With Main Contractors</span>
        <h2 class="h" id="mc-h">Electrical Scope, Delivered</h2>
        <p class="lede">
          Nazir and Company takes on the electrical scope of transmission, distribution and oil-sector programmes for main contractors, delivered by its own teams, with a large fleet of construction and stringing equipment mobilised for each project.
        </p>
        <ol class="list-num">
          <li>Overhead line foundations, tower erection and conductor stringing</li>
          <li>Overhead distribution lines, underground cables and terminations</li>
          <li>Substation civil works</li>
          <li>Oil-field electrical works, including hazardous areas</li>
          <li>Line maintenance, including live-line work</li>
        </ol>
        <p class="body-grey docs-note">Registration documents, the certificate of incorporation and the full project list are available on request.</p>
        <div class="row-links">
          <a class="pill" href="/contact/?type=subcontract&amp;country=Libya">Libya Subcontract Enquiry <Icon name="right" /></a>
        </div>
      </div>
      <div class="duo-p"><Img name="offshore-platform" alt="Oil and gas production facility at sea" sizes="(min-width: 60em) 50vw, 100vw" /></div>
    </div>
  </section>

  <section class="sec sec--soft" aria-labelledby="clients-h">
    <div class="w">
      <span class="eb">Clients</span>
      <h2 class="h" id="clients-h">Clients in Libya</h2>
      <ul class="names cl">
        {clients.map((n) => <li>{n}</li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .cl {
    margin-top: 2.5rem;
  }
  .list-num {
    margin-top: 2.25rem;
  }
  .docs-note {
    margin-top: 1.75rem;
  }
</style>
