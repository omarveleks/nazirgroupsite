---
import Base from '../layouts/Base.astro';
import { company } from '../lib/data';
---
<Base title="Privacy note" description="How the Nazir and Company website handles personal data: no cookies, cookieless analytics, and enquiry details used only to reply.">
  <header class="page-head">
    <div class="container">
      <p class="eyebrow">Privacy</p>
      <h1>Privacy note</h1>
    </div>
  </header>
  <section class="section">
    <div class="container prose">
      <h2>Who is responsible</h2>
      <p>{company.name}, {company.address}.</p>
      <h2>Cookies and analytics</h2>
      <p>This website sets no cookies. Visits may be counted with Cloudflare Web Analytics, which does not use cookies and does not identify individual visitors.</p>
      <h2>Enquiry form</h2>
      <p>
        The details sent through the enquiry form (name, organisation, email, phone, country, project details and any attached file)
        are delivered by email to the company and used only to reply to the enquiry and to follow up on it. They are not sold or
        shared for marketing.
      </p>
      <p>
        The form uses Cloudflare Turnstile to block automated submissions. Turnstile processes technical data about the browser
        for that purpose only.
      </p>
      <h2>Hosting</h2>
      <p>The website is hosted on Cloudflare Pages. Like any web server, it processes the IP address of each visitor to deliver the pages and to protect the service.</p>
      <h2>Your rights</h2>
      <p>To ask what information the company holds about an enquiry, or to have it deleted, write to the head office address above or use the <a href="/contact/">enquiry form</a>.</p>
    </div>
  </section>
</Base>
