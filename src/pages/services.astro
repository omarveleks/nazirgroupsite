---
import Base from '../layouts/Base.astro';
import SectorGlyph from '../components/SectorGlyph.astro';
import { byNewest, projectUrl, fmtKv } from '../lib/data';
import { services, serviceProjects } from '../lib/services';

const SHOW_ALL = 6;
const rows = services.map((s) => {
  const list = serviceProjects(s).sort(byNewest);
  const all = list.length <= SHOW_ALL;
  return { ...s, count: list.length, all, examples: all ? list : list.filter((p) => p.year_end !== null).slice(0, 4) };
});
---
<Base title="Services" description="Overhead transmission lines, substations, distribution, oil-field electrical, line maintenance and civil works: services of Nazir and Company, each with its documented projects.">
  <header class="page-head">
    <div class="container">
      <p class="eyebrow">Services</p>
      <h1>What the company builds</h1>
      <p class="lede">Each service below is backed by projects in the register. The count and examples are drawn from the company’s records.</p>
    </div>
  </header>

  <section class="section">
    <div class="container">
      <ol class="svc">
        {rows.map((s, i) => (
          <li id={s.id}>
            <div class="svc-art" aria-hidden="true">
              <span class="svc-n fig">{String(i + 1).padStart(2, '0')}</span>
              <SectorGlyph sector={s.glyph} />
            </div>
            <div class="svc-body">
              <h2>{s.title}</h2>
              <p>{s.intro}</p>
              <p class="svc-count"><span class="fig">{s.count}</span> documented {s.count === 1 ? 'project' : 'projects'}{s.all ? ':' : '. Recent examples:'}</p>
              <ul class="ex">
                {s.examples.map((p) => (
                  <li>
                    <a href={projectUrl(p)}>{p.name}</a>
                    <span class="exm fig">{[p.country, p.year_end, p.voltage_kv ? fmtKv(p.voltage_kv, p) : ''].filter(Boolean).join(' · ')}</span>
                  </li>
                ))}
              </ul>
              {s.registerFilter && !s.all && (
                <p><a class="btn btn--ghost" href={`/projects/${s.registerFilter}#register`}>See all {s.count} in the register</a></p>
              )}
              {s.relatedFilter && (
                <p><a class="btn btn--ghost" href={`/projects/${s.relatedFilter.href}#register`}>{s.relatedFilter.label}</a></p>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  .svc {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .svc > li {
    display: grid;
    gap: 1.25rem;
    padding-block: 2rem;
    border-top: 1px solid var(--navy);
    scroll-margin-top: 1rem;
  }
  .svc > li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .svc > li > * {
    min-width: 0;
  }
  @media (min-width: 48rem) {
    .svc > li {
      grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
      gap: 2rem;
    }
  }
  .svc-art {
    border: 1px solid var(--rule);
    background: var(--panel);
    padding: 0.5rem 0.75rem 0.75rem;
    max-width: 18rem;
  }
  .svc-n {
    display: block;
    color: var(--amber-ink);
    font-size: 0.875rem;
    margin-bottom: 0.25rem;
  }
  .svc h2 {
    font-size: var(--step-2);
  }
  .svc-count {
    font-size: var(--step--1);
    color: var(--muted);
    margin-bottom: 0.4rem;
  }
  .svc-count .fig {
    color: var(--navy);
  }
  .ex {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    border-top: 1px solid var(--rule);
  }
  .ex li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 1rem;
    border-bottom: 1px solid var(--rule);
    padding: 0.2rem 0;
    max-width: none;
  }
  .ex a {
    overflow-wrap: anywhere;
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
  }
  .exm {
    color: var(--muted);
    font-size: 0.875rem;
    align-self: center;
  }
</style>
