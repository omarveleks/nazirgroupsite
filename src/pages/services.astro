---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import More from '../components/More.astro';
import Statement from '../components/Statement.astro';
import { byNewest, projectUrl } from '../lib/data';
import { services, serviceProjects } from '../lib/services';

const rows = services.map((s) => {
  const list = serviceProjects(s).sort(byNewest);
  return { ...s, examples: list.filter((p) => p.year_end !== null).slice(0, 4) };
});
---
<Base
  title="OHTL, Substation, EPC and Construction Services"
  description="Overhead transmission lines (OHTL), turnkey EPC lines, substations, distribution networks, oil-field electrical works, line maintenance, civil infrastructure and telecommunications: the services of Nazir and Company, with example projects."
>
  <header class="page-head w">
    <span class="eb">Services</span>
    <h1 class="h h--xl">End-to-End Delivery Across the Power Value Chain</h1>
    <p class="lede">Overhead transmission lines (OHTL) and turnkey (EPC) lines, substations, distribution, oil-field power, civil construction and telecommunications, each backed by projects in the company’s record.</p>
  </header>

  {rows.map((s, i) => (
    <section class={`sec${i % 2 ? ' sec--soft' : ''}`} id={s.id} aria-labelledby={`${s.id}-h`}>
      <div class={`w duo${i % 2 ? ' duo--flip' : ''}`}>
        <div class="duo-t">
          <span class="eb">{String(i + 1).padStart(2, '0')}</span>
          <h2 class="h" id={`${s.id}-h`}>{s.title}</h2>
          <p class="lede">{s.intro}</p>
          {s.examples.length > 0 && (
            <ul class="ex">
              {s.examples.map((p) => (
                <li><a href={projectUrl(p)}>{p.name}</a><span>{p.country}</span></li>
              ))}
            </ul>
          )}
          <div class="row-links">
            {s.registerFilter && <More href={`/projects/${s.registerFilter}#register`} label="All Projects" />}
            {s.relatedFilter && <More href={`/projects/${s.relatedFilter.href}#register`} label="Oil-Field Projects" />}
          </div>
        </div>
        {s.photo && (
          <figure class="duo-p">
            <Img name={s.photo.name} alt={s.photo.alt} sizes="(min-width: 60em) 50vw, 100vw" />
            <figcaption>{s.photo.caption}</figcaption>
          </figure>
        )}
      </div>
    </section>
  ))}

  <Statement text="Discuss transmission, substation and infrastructure programmes with the business development team." link={{ href: '/contact/?type=partnership', label: 'Contact' }}>
    Partner With Nazir and Company
  </Statement>
</Base>

<style>
  .ex {
    list-style: none;
    padding: 0;
    margin-top: 2.25rem;
    border-top: 1px solid var(--line);
  }
  .ex li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0 1.5rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--line);
  }
  .ex a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font: 400 1.0625rem/1.3 var(--display);
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.25em;
  }
  .ex a:hover {
    text-decoration-color: var(--blue);
  }
  .ex span {
    font-size: 0.875rem;
    color: var(--grey);
  }
  .row-links {
    margin-top: 1.75rem;
  }
  figure.duo-p {
    margin: 0;
  }
  .duo-p figcaption {
    position: relative;
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--grey);
  }
</style>
