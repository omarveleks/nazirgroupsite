---
import Base from '../layouts/Base.astro';
import Leadership from '../components/Leadership.astro';
import Advisers from '../components/Advisers.astro';
import Engineers from '../components/Engineers.astro';
import Statement from '../components/Statement.astro';
import { company } from '../lib/data';

const d = company.director;
---
<Base
  title="Leadership and team"
  description={`${d.name}, Director of Nazir and Company; the founder, ${company.founder.name} (${company.founder.born}–${company.founder.died}); key advisers and selected engineers.`}
>
  <header class="page-head w">
    <span class="eb">Leadership and Team</span>
    <h1 class="h h--xl">The People Behind the Delivery</h1>
    <p class="lede">The company is led by its Director, {d.name}, with the support of a team of senior advisers and engineers registered with the Pakistan Engineering Council.</p>
  </header>

  <section class="sec--tight" aria-labelledby="director-h">
    <div class="w">
      <h2 class="visually-hidden" id="director-h">Director and founder</h2>
      <Leadership />
    </div>
  </section>

  <section class="sec sec--soft" aria-labelledby="advisers-h">
    <div class="w">
      <span class="eb">Advisers</span>
      <h2 class="h head-row" id="advisers-h">Key Advisers</h2>
      <Advisers />
    </div>
  </section>

  <section class="sec" aria-labelledby="engineers-h">
    <div class="w">
      <div class="grid2 head-row">
        <div>
          <span class="eb">Engineers</span>
          <h2 class="h" id="engineers-h">Selected Engineers</h2>
        </div>
        <p class="body-grey">Engineers listed on the company licence. The full technical team is available on request.</p>
      </div>
      <Engineers />
    </div>
  </section>

  <Statement text="Discuss transmission, substation and infrastructure programmes with the business development team." link={{ href: '/contact/?type=partnership', label: 'Contact' }}>
    Partner With Nazir and Company
  </Statement>
</Base>
