---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import Go from '../components/Go.astro';
import More from '../components/More.astro';
import Band from '../components/Band.astro';
import Track from '../components/Track.astro';
import CapTabs from '../components/CapTabs.astro';
import Decades from '../components/Decades.astro';
import Presence from '../components/Presence.astro';
import ClientsGrid from '../components/ClientsGrid.astro';
import Connect from '../components/Connect.astro';
import { company, stats } from '../lib/data';
import { HERO_SLIDES, FEATURED, MAX_AC_KV, numberWord } from '../lib/site';

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': new URL('/#office', Astro.site).href,
  name: company.name,
  url: new URL('/', Astro.site).href,
  image: new URL('/og/nazir.png', Astro.site).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '100 Abu Bakr Block, New Garden Town',
    addressLocality: 'Lahore',
    addressRegion: 'Punjab',
    addressCountry: 'PK',
  },
  parentOrganization: { '@id': new URL('/#organization', Astro.site).href },
};
const n = HERO_SLIDES.length;
---
<Base
  title="Nazir and Company | Built to Last Since 1958"
  description="Nazir and Company (Pvt) Ltd, Lahore: high-voltage transmission, substations and critical infrastructure for national utilities, energy producers and governments across Asia, the Middle East and Africa since 1958."
  jsonLd={[localBusiness]}
  heroPhoto="tower-sky"
>
  <section class="hero on-dark">
    <Img name="tower-sky" alt="High-voltage transmission tower against the sky" class="hero-img" priority />
    <div class="w hero-in">
      <div class="hero-copy">
        <h1>Built to Last Since {company.founded}</h1>
        <p>High-voltage transmission, substations and critical infrastructure for national utilities, energy producers and governments across Asia, the Middle East and Africa.</p>
        <Go href="/projects/" label="Explore the Projects" up />
      </div>
      <div class="hc" data-carousel>
        <div class="hcard">
          {HERO_SLIDES.map((s, i) => (
            <div class="hc-slide" data-slide hidden={i > 0} role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${n}`}>
              <div class="ph"><Img name={s.photo} sizes="21rem" /></div>
              <p class="hc-tag">{s.tag}</p>
              <p class="hc-t">{s.title}</p>
              <Go href={s.href} up class="hc-go" ariaLabel={`Open project: ${s.title}`} />
            </div>
          ))}
          <div class="dots">
            {HERO_SLIDES.map((_, i) => (
              <button class="dot" type="button" data-to={i} aria-label={`Show project ${i + 1} of ${n}`} aria-current={i === 0 ? 'true' : 'false'}></button>
            ))}
          </div>
        </div>
        <button class="arr arr--l" type="button" data-prev aria-label="Previous project"><Icon name="chevron-left" /></button>
        <button class="arr arr--r" type="button" data-next aria-label="Next project"><Icon name="chevron-right" /></button>
      </div>
    </div>
  </section>

  <section class="ab" aria-labelledby="about-h">
    <div class="w abg">
      <div class="abp"><Img name="substation" alt="Grid substation" sizes="(min-width: 60em) 45vw, 100vw" /></div>
      <div class="abt">
        <span class="eb">About Nazir and Company</span>
        <h2 class="h" id="about-h">Delivering the Infrastructure Nations <mark class="hl">Run On</mark></h2>
        <p class="lede">
          For more than six decades, Nazir and Company has built the high-voltage networks, substations and civil infrastructure for utilities, industry and government. From its headquarters in Lahore, the company delivers landmark projects for national utilities and energy leaders across Asia, the Middle East and Africa, with a reputation for engineering depth, disciplined execution and performance in the most demanding environments.
        </p>
        <Go href="/about/" label="About the Company" />
      </div>
    </div>
  </section>

  <section class="sb sb--under on-dark" aria-label="Key figures">
    <ul class="w sg">
      <li><span class="sg-n">{company.founded}</span><span class="sg-l">Founded in Lahore</span></li>
      <li><span class="sg-n">{stats.countries}</span><span class="sg-l">Countries across Asia, the Middle East and Africa</span></li>
      <li><span class="sg-n">{MAX_AC_KV}<small>kV</small></span><span class="sg-l">Transmission capability, up to HVDC</span></li>
      <li><span class="sg-n">No. 1</span><span class="sg-l">Licence of the Pakistan Engineering Council</span></li>
    </ul>
  </section>

  <section class="sec lined" aria-labelledby="cap-h">
    <div class="w">
      <div class="grid2 head-row">
        <div>
          <span class="eb">Capabilities</span>
          <h2 class="h" id="cap-h">End-to-End Delivery Across the Power Value Chain</h2>
        </div>
        <p class="body-grey">
          From foundations and tower erection to stringing and turnkey lines, Nazir and Company executes complex programmes with its own teams, and mobilises a large fleet of construction and stringing equipment for each project.
        </p>
      </div>
      <CapTabs />
    </div>
  </section>

  <Band photo="desert-lines" alt="High-voltage transmission lines crossing the desert">
    <Fragment slot="title">Experience in Demanding Terrain</Fragment>
    <p>From the Sahara to the Arabian Peninsula, Nazir and Company delivers high-voltage transmission where conditions are most extreme and reliability matters most.</p>
    <div class="row-links"><Go href="/projects/" label="View Projects" /></div>
  </Band>

  <section class="sec" aria-labelledby="feat-h">
    <div class="w grid2 head-row">
      <div>
        <span class="eb">Projects</span>
        <h2 class="h" id="feat-h">Featured Projects</h2>
      </div>
      <p class="body-grey">Transmission and infrastructure projects for national utilities and energy companies across Asia, the Middle East and Africa.</p>
    </div>
    <Track items={FEATURED} label="Featured projects" />
  </section>

  <Band photo="engineering-drawings" alt="Engineering drawings on site">
    <Fragment slot="title">Experience in <span class="accent">Libya</span></Fragment>
    <p>
      For over three decades, Nazir and Company built high-voltage lines from Tripoli to Benghazi and deep into the Fezzan, and electrical systems for the country’s leading oil producers. {company.libya_status}
    </p>
    <div class="row-links"><Go href="/libya/" label="Nazir in Libya" /></div>
  </Band>

  <section class="sec lined" aria-labelledby="heritage-h">
    <div class="w lg">
      <div class="lgt">
        <span class="eb">Heritage</span>
        <h2 class="h" id="heritage-h">Six Decades of Delivery</h2>
        <p class="body-grey">
          Founded in Lahore in {company.founded}, Nazir and Company holds Licence No. 1 of the Pakistan Engineering Council, the first the Council ever issued. By the late 1970s the company was building high-voltage transmission in Iraq and Libya, and it has since delivered across {numberWord(stats.countries).toLowerCase()} countries in Asia, the Middle East and Africa.
        </p>
        <p class="body-grey">Today, Nazir and Company combines six decades of field experience with the capacity to execute complex power and infrastructure programmes at national scale.</p>
        <div class="row-links"><Go href="/about/#heritage" label="Company History" /></div>
      </div>
      <Decades />
    </div>
  </section>

  <section class="sec sec--soft" aria-labelledby="presence-h">
    <div class="w">
      <div class="grid2 head-row">
        <div>
          <span class="eb">Global Presence</span>
          <h2 class="h" id="presence-h">{numberWord(stats.countries)} Countries, Three Regions</h2>
        </div>
        <div>
          <p class="body-grey">Headquartered in Lahore, Nazir and Company has delivered across Asia, the Middle East and Africa.</p>
          <More href="/global-presence/" label="View All Locations" />
        </div>
      </div>
      <Presence />
    </div>
  </section>

  <section class="sec" aria-labelledby="discover-h">
    <div class="w">
      <div class="grid2 head-row">
        <div>
          <span class="eb">Explore</span>
          <h2 class="h" id="discover-h">Discover Nazir and Company</h2>
        </div>
        <div>
          <p class="body-grey">Capabilities, regions and the heritage behind six decades of delivery.</p>
          <More href="/about/" label="View All" />
        </div>
      </div>
      <div class="mg">
        <a class="mt m1" href="/libya/"><Img name="desert-lines" sizes="(min-width: 60em) 58vw, 100vw" /><div class="mt-t"><span class="chip">Region</span><h3>Libya: Powering the Next Chapter</h3></div></a>
        <a class="mt m2" href="/services/#substations"><Img name="substation" sizes="(min-width: 60em) 42vw, 100vw" /><div class="mt-t"><span class="chip">Capability</span><h3>Grid Substations</h3></div></a>
        <a class="mt m3" href={HERO_SLIDES[1]!.href}><Img name="tower-mono" sizes="(min-width: 60em) 42vw, 100vw" /><div class="mt-t"><span class="chip">Project</span><h3>Makkah, Taif &amp; Madinah 380 kV</h3></div></a>
        <a class="mt m4" href="/contact/?type=careers"><Img name="site-engineer" sizes="(min-width: 60em) 50vw, 100vw" /><div class="mt-t"><span class="chip">People</span><h3>Careers in Critical Infrastructure</h3></div></a>
        <a class="mt m5" href="/about/"><Img name="engineering-drawings" sizes="(min-width: 60em) 50vw, 100vw" /><div class="mt-t"><span class="chip">Company</span><h3>Six Decades of Engineering Heritage</h3></div></a>
      </div>
    </div>
  </section>

  <section class="sec sec--tight" aria-labelledby="clients-h">
    <div class="w">
      <div class="grid2 head-row">
        <div>
          <span class="eb">Clients</span>
          <h2 class="h" id="clients-h">Trusted by National Utilities and Energy Leaders</h2>
        </div>
        <p class="body-grey">Nazir and Company has delivered for the organisations that build and run national power, energy and road networks.</p>
      </div>
      <ClientsGrid />
      <ul class="regs">
        <li><b>Pakistan Engineering Council</b> · Licence No. 1</li>
        <li><b>Pre-qualified</b> · {company.prequalified_short.join(' · ')}</li>
      </ul>
    </div>
  </section>

  <Connect />
</Base>
