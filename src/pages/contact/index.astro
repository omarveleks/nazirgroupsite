---
import Base from '../../layouts/Base.astro';
import ContactDetails from '../../components/ContactDetails.astro';
import Icon from '../../components/Icon.astro';
import { FORM_ENABLED, TURNSTILE_SITE_KEY, countries } from '../../lib/data';

const types = [
  { v: 'client', l: 'Client' },
  { v: 'subcontract', l: 'Main contractor subcontract enquiry' },
  { v: 'partnership', l: 'Partnership' },
  { v: 'careers', l: 'Careers' },
  { v: 'other', l: 'Other' },
];
const countryHints = [...countries.map((c) => c.name), 'United Arab Emirates', 'Qatar', 'Oman', 'Kuwait', 'Egypt', 'Tunisia', 'Algeria'];
const turnstile = FORM_ENABLED && TURNSTILE_SITE_KEY;
---
<Base title="Contact" description="Contact Nazir and Company: clients, main contractors (including Libya subcontracts), partnerships and careers. Head office: 100 Abu Bakr Block, New Garden Town, Lahore.">
  <header class="page-head w">
    <span class="eb">Contact</span>
    <h1 class="h h--xl">Let’s Build What’s Next</h1>
    <p class="lede">For clients, main contractors, partners and engineers who want to join the company’s project teams.</p>
  </header>

  <section class="sec--tight contact-sec">
    <div class="w contact-grid">
      <div>
        {!FORM_ENABLED && (
          <div class="note" role="status">
            <p><strong>Form not yet connected.</strong> Enquiries cannot be sent from this page yet.</p>
          </div>
        )}
        <form class="form enq" action="/api/contact" method="post" enctype="multipart/form-data" data-enquiry>
          <div class="field">
            <label for="type">Type of enquiry <span class="req">(required)</span></label>
            <select id="type" name="type" required>
              {types.map((t) => <option value={t.v}>{t.l}</option>)}
            </select>
          </div>
          <div class="form-2">
            <div class="field">
              <label for="name">Name <span class="req">(required)</span></label>
              <input id="name" name="name" type="text" autocomplete="name" required maxlength="200" />
            </div>
            <div class="field">
              <label for="org">Organisation</label>
              <input id="org" name="organisation" type="text" autocomplete="organization" maxlength="200" />
            </div>
          </div>
          <div class="form-2">
            <div class="field">
              <label for="email">Email <span class="req">(required)</span></label>
              <input id="email" name="email" type="email" inputmode="email" autocomplete="email" required maxlength="254" />
            </div>
            <div class="field">
              <label for="phone">Phone</label>
              <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" maxlength="40" />
            </div>
          </div>
          <div class="field">
            <label for="country">Country of the project</label>
            <input id="country" name="country" type="text" list="country-list" autocomplete="country-name" maxlength="80" />
            <datalist id="country-list">
              {countryHints.map((c) => <option value={c} />)}
            </datalist>
          </div>
          <div class="field">
            <label for="details">Project details <span class="req">(required)</span></label>
            <textarea id="details" name="details" rows="7" required minlength="10" maxlength="5000" aria-describedby="details-hint"></textarea>
            <p class="hint" id="details-hint">Scope, voltage, length, location and timing, as far as known.</p>
          </div>
          <div class="field">
            <label for="file">Attach a file</label>
            <input id="file" name="file" type="file" accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png" aria-describedby="file-hint" />
            <p class="hint" id="file-hint">Optional. PDF, Word, Excel, JPEG or PNG, up to 5 MB.</p>
          </div>
          <div class="hp" aria-hidden="true">
            <label for="website">Leave this field empty</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          {turnstile && <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="light"></div>}
          <p class="hint">The details are used only to reply to this enquiry. <a href="/privacy/">Privacy note</a>.</p>
          <p class="status" data-status role="status" aria-live="polite"></p>
          <div>
            <button class="pill" type="submit" disabled={!FORM_ENABLED} aria-disabled={!FORM_ENABLED ? 'true' : undefined}>Send Enquiry <Icon name="right" /></button>
          </div>
        </form>
      </div>
      <aside class="side" aria-labelledby="office-h">
        <span class="eb">Head Office</span>
        <h2 class="side-h" id="office-h">Lahore, Pakistan</h2>
        <ContactDetails />
        <p class="hint">No map is embedded on this page to keep it fast; the link opens a map service.</p>
      </aside>
    </div>
  </section>
  {turnstile && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script src="../../scripts/contact.ts"></script>
</Base>

<style>
  .contact-grid {
    display: grid;
    gap: 4rem;
    align-items: start;
  }
  @media (min-width: 60em) {
    .contact-grid {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      column-gap: clamp(3rem, 7vw, 8rem);
    }
  }
  .contact-sec {
    padding-bottom: var(--sec);
  }
  .note {
    margin: 0 0 2.5rem;
  }
  .req {
    font: 300 0.8125rem/1 var(--body);
    letter-spacing: 0;
    text-transform: none;
    color: var(--grey);
  }
  .hint {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--grey);
  }
  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .cf-turnstile {
    min-height: 65px;
  }
  .status {
    margin: 0;
    font-weight: 500;
  }
  .status:empty {
    display: none;
  }
  .status[data-kind='error'] {
    color: #b3261e;
  }
  .status[data-kind='ok'] {
    color: #1d5e2e;
  }
  .side {
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .side-h {
    font: 300 clamp(1.75rem, 3vw, 2.5rem) / 1.1 var(--display);
    margin-bottom: 1.5rem;
  }
  .side .hint {
    margin-top: 1.5rem;
  }
</style>
