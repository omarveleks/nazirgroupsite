---
import Base from '../../layouts/Base.astro';
---
<Base title="Enquiry not sent" description="The enquiry could not be sent." noindex>
  <header class="page-head">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>The enquiry was not sent</h1>
      <p class="lede">Please check the form and try again.</p>
      <ul>
        <li>Name, email, type of enquiry and project details are required.</li>
        <li>An attached file must be a PDF, Word, Excel, JPEG or PNG file of up to 5 MB.</li>
        <li>The security check needs JavaScript to be enabled.</li>
        <li>Several enquiries sent in a few minutes are held back; wait ten minutes and try again.</li>
      </ul>
      <div class="btn-row">
        <a class="btn" href="/contact/">Back to the form</a>
      </div>
    </div>
  </header>
</Base>
