---
import Base from '../../layouts/Base.astro';
import Statement from '../../components/Statement.astro';
import Track from '../../components/Track.astro';
import Register from '../../components/Register.astro';
import ClientsGrid from '../../components/ClientsGrid.astro';
import { countries, projects, stats, byNewest } from '../../lib/data';
import { FEATURED, countryMeta, numberWord, PRESENCE_ORDER } from '../../lib/site';

const all = [...projects].sort(byNewest);
// Country cards, largest record first (Libya keeps its own page for prominence)
const cards = [...countries]
  .sort((a, b) => b.count - a.count || PRESENCE_ORDER.indexOf(a.slug) - PRESENCE_ORDER.indexOf(b.slug))
  .map((c) => {
    const m = countryMeta(c.slug);
    return { tag: m.region, title: c.name, sub: m.descriptor, href: `/projects/${c.slug}/`, photo: m.photo };
  });
---
<Base
  title="Projects"
  description={`Projects by Nazir and Company in ${numberWord(stats.countries).toLowerCase()} countries: high-voltage transmission lines, substations, distribution networks and civil infrastructure for national utilities, energy producers and governments.`}
>
  <Statement
    level="h1"
    eyebrow="Projects"
    text="High-voltage transmission, substations, distribution networks and civil infrastructure for national utilities, energy producers and governments. Choose a country, or search every project."
    link={{ href: '#register', label: 'Search All Projects' }}
  >
    Project Record
  </Statement>

  <section class="sec--tight" id="featured" aria-labelledby="feat-h">
    <div class="w grid2 head-row">
      <div>
        <span class="eb">Selected Work</span>
        <h2 class="h" id="feat-h">Featured Projects</h2>
      </div>
      <p class="body-grey">Transmission and infrastructure projects for national utilities and energy companies across Asia, the Middle East and Africa.</p>
    </div>
    <Track items={FEATURED} label="Featured projects" />
  </section>

  <section class="sec" id="countries" aria-labelledby="countries-h">
    <div class="w grid2 head-row">
      <div>
        <span class="eb">By Country</span>
        <h2 class="h" id="countries-h">{numberWord(stats.countries)} Countries, Three Regions</h2>
      </div>
      <p class="body-grey">From the national grid in Pakistan to the Libyan Sahara, the Holy Cities and the Zambezi.</p>
    </div>
    <Track items={cards} label="Countries" />
  </section>

  <section class="sec" aria-labelledby="all-h">
    <div class="w">
      <div class="grid2 head-row">
        <div>
          <span class="eb">Project List</span>
          <h2 class="h" id="all-h">Search All Projects</h2>
        </div>
        <div class="field">
          <label for="global-q">Search</label>
          <input id="global-q" type="search" inputmode="search" autocomplete="off" placeholder="For example: 220 kV, Sebha, WAPDA" data-global-search="all" />
        </div>
      </div>
      <details class="allc" id="register">
        <summary class="pill">All countries <span class="allc-n">({stats.projects})</span></summary>
        <div class="allc-body">
          <Register id="all" groups={[{ id: 'all', projects: all }]} showCountry caption="All projects, newest first" />
        </div>
      </details>
    </div>
  </section>

  <section class="sec sec--soft" aria-labelledby="clients-h">
    <div class="w">
      <div class="grid2 head-row">
        <div>
          <span class="eb">Clients</span>
          <h2 class="h" id="clients-h">Selected Clients</h2>
        </div>
        <p class="body-grey">National utilities, energy producers and road authorities in Asia, the Middle East and Africa.</p>
      </div>
      <ClientsGrid />
    </div>
  </section>
</Base>

<style>
  .allc > summary {
    list-style: none;
  }
  .allc > summary::-webkit-details-marker {
    display: none;
  }
  .allc-n {
    font-weight: 300;
    opacity: 0.8;
  }
  .allc[open] > summary {
    margin-bottom: 2.5rem;
  }
  .allc-body {
    min-width: 0;
  }
</style>
