---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Register from '../../../components/Register.astro';
import Go from '../../../components/Go.astro';
import More from '../../../components/More.astro';
import { countries, clientsFor, type CountryInfo } from '../../../lib/data';
import { countryMeta } from '../../../lib/site';

export function getStaticPaths() {
  return countries.map((c) => ({ params: { country: c.slug }, props: { c } }));
}

interface Props {
  c: CountryInfo;
}
const { c } = Astro.props;
const m = countryMeta(c.slug);
const groups =
  c.slug === 'pakistan'
    ? [
        { id: 'grid', title: 'NTDC/WAPDA (national grid)', projects: c.projects.filter((p) => p.group === 'national-grid') },
        { id: 'regional', title: 'Regional and provincial works', projects: c.projects.filter((p) => p.group !== 'national-grid') },
      ]
    : [{ id: 'all', projects: c.projects }];
const clients = clientsFor(c.projects);
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Projects', item: new URL('/projects/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: c.name, item: new URL(`/projects/${c.slug}/`, Astro.site).href },
  ],
};
const others = countries.filter((x) => x.slug !== c.slug);
---
<Base
  title={`Transmission and Construction Projects in ${c.name}`}
  description={`Nazir and Company in ${c.name}. ${m.descriptor.replace(' · ', '. ').replace('&', 'and')}. Project list with client, year, voltage and length for each project.`}
  jsonLd={[crumbs]}
  current="/projects/"
  heroPhoto={m.photo}
>
  <PageHero
    photo={m.photo}
    eyebrow={m.region}
    lede={m.descriptor}
    crumbs={[{ href: '/projects/', label: 'Projects' }, { label: c.name }]}
  >
    <Fragment slot="title">{c.slug === 'libya' ? <>Projects in <span class="accent">Libya</span></> : c.name}</Fragment>
    {c.slug === 'libya' && (
      <div class="row-links"><Go href="/libya/" label="Nazir in Libya" /></div>
    )}
  </PageHero>

  {clients.length > 0 && (
    <section class="sec--tight" aria-labelledby="clients-h">
      <div class="w">
        <span class="eb">Clients</span>
        <h2 class="h" id="clients-h">Clients in {c.name}</h2>
        <ul class="names cl-names">
          {clients.map((n) => <li>{n}</li>)}
        </ul>
      </div>
    </section>
  )}

  <section class="sec sec--soft" id="register" aria-labelledby="reg-h">
    <div class="w">
      <span class="eb">Project List</span>
      <h2 class="h" id="reg-h">Projects in {c.name}</h2>
      <div class="reg-wrap">
        <Register id={c.slug} groups={groups} caption={`Projects in ${c.name}, newest first`} />
      </div>
    </div>
  </section>

  <section class="sec--tight" aria-labelledby="other-h">
    <div class="w">
      <h2 class="eb" id="other-h">Other Countries</h2>
      <ul class="row-links other">
        {others.map((o) => <li><More href={`/projects/${o.slug}/`} label={o.name} /></li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .cl-names {
    margin-top: 2.5rem;
  }
  .reg-wrap {
    margin-top: 2.5rem;
  }
  .other {
    list-style: none;
    padding: 0;
  }
</style>
