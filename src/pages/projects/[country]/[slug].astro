---
import Base from '../../../layouts/Base.astro';
import SectorGlyph from '../../../components/SectorGlyph.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import {
  projects,
  country as getCountry,
  fmtKm,
  fmtValue,
  fmtKv,
  projectUrl,
  ROLE_LABEL,
  SECTOR_LABEL,
  sourceText,
  yearText,
  type Project,
} from '../../../lib/data';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { country: p.country_slug, slug: p.slug }, props: { p } }));
}

interface Props {
  p: Project;
}
const { p } = Astro.props;
const c = getCountry(p.country_slug);
// "More from" this country: same sector first, then nearest in year
const others = c.projects
  .filter((x) => x.slug !== p.slug)
  .map((x) => ({
    x,
    score: (x.sector === p.sector ? 0 : 1000) + Math.abs((x.year_end ?? 0) - (p.year_end ?? 0)) + (x.flagship ? -5 : 0),
  }))
  .sort((a, b) => a.score - b.score)
  .slice(0, 3)
  .map((o) => o.x);
const kv = fmtKv(p.voltage_kv, p);
const km = fmtKm(p.length_km);
const value = fmtValue(p);
const url = new URL(projectUrl(p), Astro.site).href;
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Projects', item: new URL('/projects/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: c.name, item: new URL(`/projects/${c.slug}/`, Astro.site).href },
    { '@type': 'ListItem', position: 3, name: p.name, item: url },
  ],
};
const desc = [p.name, p.client, c.name, p.year_end ? String(p.year_end) : '', kv, km].filter(Boolean).join(' · ');
---
<Base title={`${p.name}, ${c.name}`} description={`${desc}. Project record of Nazir and Company.`} jsonLd={[crumbs]} current="/projects/">
  <article>
    <header class="page-head">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/projects/">Projects</a></li>
            <li><a href={`/projects/${c.slug}/`}>{c.name}</a></li>
            <li aria-current="page">{p.name}</li>
          </ol>
        </nav>
        <p class="eyebrow">{SECTOR_LABEL[p.sector]}{p.flagship ? ' · Flagship' : ''}</p>
        <h1>{p.name}</h1>
      </div>
    </header>

    <section class="section">
      <div class="container sheet">
        <div class="main">
          <dl class="tblock">
            <div><dt>Client</dt><dd>{p.client}</dd></div>
            <div><dt>Country</dt><dd>{c.name}</dd></div>
            {p.region && <div><dt>Region</dt><dd>{p.region}</dd></div>}
            <div><dt>Completed</dt><dd class="fig">{yearText(p)}</dd></div>
            {kv && <div><dt>Voltage</dt><dd class="fig">{kv}</dd></div>}
            {km && <div><dt>Length</dt><dd class="fig">{km}</dd></div>}
            {p.role !== 'unknown' && <div><dt>Role</dt><dd>{ROLE_LABEL[p.role]}</dd></div>}
            <div><dt>Sector</dt><dd>{SECTOR_LABEL[p.sector]}</dd></div>
            {value && <div><dt>{p.role === 'jv' ? 'Joint-venture contract value' : 'Contract value'}</dt><dd class="fig">{value}</dd></div>}
          </dl>
          <h2 class="h">Scope</h2>
          <p class="scope">{p.scope}</p>
          <p class="src"><span class="k">Source</span> {sourceText(p)}{p.source.url && <>; also <a href={p.source.url} rel="noopener">{new URL(p.source.url).hostname.replace(/^www\./, '')}</a></>}</p>
        </div>
        <figure class="drawing">
          <SectorGlyph sector={p.sector} />
          <figcaption>
            <span class="k">Drawing</span> Schematic of the type of work. Not a drawing of this project.
          </figcaption>
        </figure>
      </div>
    </section>

    {others.length > 0 && (
      <section class="section" aria-labelledby="more-h">
        <div class="container">
          <h2 id="more-h">More from {c.name}</h2>
          <div class="grid">
            {others.map((o) => <ProjectCard p={o} showCountry={false} />)}
          </div>
          <p class="back"><a href={`/projects/${c.slug}/`}>All {c.count} projects in {c.name}</a></p>
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  .sheet {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 60rem) {
    .sheet {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      align-items: start;
    }
  }
  .h {
    font-size: var(--step-2);
    margin-top: 1.75rem;
  }
  .scope {
    font-size: var(--step-1);
  }
  .src {
    font-size: var(--step--1);
    color: var(--muted);
    border-top: 1px dashed var(--rule);
    padding-top: 0.75rem;
  }
  .k {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-right: 0.5rem;
  }
  .drawing {
    margin: 0;
    border: 1px solid var(--navy);
    background: var(--panel);
    padding: 1rem;
  }
  .drawing figcaption {
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--rule);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .back a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-top: 1rem;
    font-weight: 600;
  }
</style>
