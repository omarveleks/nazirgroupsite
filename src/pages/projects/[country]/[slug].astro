---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import More from '../../../components/More.astro';
import {
  projects,
  country as getCountry,
  fmtKm,
  fmtValue,
  fmtKv,
  projectUrl,
  ROLE_LABEL,
  SECTOR_LABEL,
  sourceText,
  yearText,
  type Project,
} from '../../../lib/data';
import { projectPhoto } from '../../../lib/site';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { country: p.country_slug, slug: p.slug }, props: { p } }));
}

interface Props {
  p: Project;
}
const { p } = Astro.props;
const c = getCountry(p.country_slug);
// "More from" this country: same sector first, then nearest in year
const others = c.projects
  .filter((x) => x.slug !== p.slug)
  .map((x) => ({
    x,
    score: (x.sector === p.sector ? 0 : 1000) + Math.abs((x.year_end ?? 0) - (p.year_end ?? 0)) + (x.flagship ? -5 : 0),
  }))
  .sort((a, b) => a.score - b.score)
  .slice(0, 3)
  .map((o) => o.x);
const kv = fmtKv(p.voltage_kv, p);
const km = fmtKm(p.length_km);
const value = fmtValue(p);
const photo = projectPhoto(p);
const url = new URL(projectUrl(p), Astro.site).href;
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Projects', item: new URL('/projects/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: c.name, item: new URL(`/projects/${c.slug}/`, Astro.site).href },
    { '@type': 'ListItem', position: 3, name: p.name, item: url },
  ],
};
const desc = [p.name, p.client, c.name, p.year_end ? String(p.year_end) : '', kv, km].filter(Boolean).join(' · ');
---
<Base title={`${p.name}, ${c.name}`} description={`${desc}. Project of Nazir and Company.`} jsonLd={[crumbs]} current="/projects/" heroPhoto={photo}>
  <article>
    <PageHero
      photo={photo}
      eyebrow={`${c.name} · ${SECTOR_LABEL[p.sector]}`}
      crumbs={[{ href: '/projects/', label: 'Projects' }, { href: `/projects/${c.slug}/`, label: c.name }, { label: p.name }]}
    >
      <Fragment slot="title">{p.name}</Fragment>
    </PageHero>

    <section class="sec" aria-labelledby="facts-h">
      <div class="w">
        <h2 class="visually-hidden" id="facts-h">Project facts</h2>
        <dl class="facts">
          <div><dt>Client</dt><dd>{p.client}</dd></div>
          <div><dt>Country</dt><dd><a href={`/projects/${c.slug}/`}>{c.name}</a></dd></div>
          {p.region && <div><dt>Region</dt><dd>{p.region}</dd></div>}
          <div><dt>Completed</dt><dd>{yearText(p)}</dd></div>
          {kv && <div><dt>Voltage</dt><dd>{kv}</dd></div>}
          {km && <div><dt>Length</dt><dd>{km}</dd></div>}
          {p.role !== 'unknown' && <div><dt>Role</dt><dd>{ROLE_LABEL[p.role]}</dd></div>}
          <div><dt>Sector</dt><dd>{SECTOR_LABEL[p.sector]}</dd></div>
          {value && <div><dt>{p.role === 'jv' ? 'Joint-venture contract value' : 'Contract value'}</dt><dd>{value}</dd></div>}
        </dl>
        <div class="grid2 scope-row">
          <div>
            <span class="eb">Scope</span>
            <p class="scope">{p.scope}</p>
          </div>
          <p class="src">
            <strong>Source:</strong> {sourceText(p)}{p.source.url && <>; also <a href={p.source.url} rel="noopener">{new URL(p.source.url).hostname.replace(/^www\./, '')}</a></>}.
            The photograph shows the type of work and is illustrative.
          </p>
        </div>
      </div>
    </section>

    {others.length > 0 && (
      <section class="sec sec--soft" aria-labelledby="more-h">
        <div class="w">
          <div class="grid2 head-row">
            <h2 class="h" id="more-h">More from {c.name}</h2>
            <More href={`/projects/${c.slug}/`} label={`All Projects in ${c.name}`} />
          </div>
          <ul class="cards">
            {others.map((o) => (
              <li><ProjectCard item={{ tag: SECTOR_LABEL[o.sector], title: o.name, href: projectUrl(o), photo: projectPhoto(o) }} sizes="(min-width: 60em) 30vw, (min-width: 40em) 45vw, 100vw" /></li>
            ))}
          </ul>
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  .scope-row {
    margin-top: clamp(3rem, 6vw, 5rem);
    align-items: start;
  }
  .scope-row .src {
    margin: 0;
  }
</style>
