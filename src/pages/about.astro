---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Portrait from '../components/Portrait.astro';
import Decades from '../components/Decades.astro';
import Statement from '../components/Statement.astro';
import { company, stats } from '../lib/data';
import { MAX_AC_KV, numberWord } from '../lib/site';

const d = company.director;
const f = company.founder;
const list = (xs: string[]) => (xs.length > 1 ? `${xs.slice(0, -1).join(', ')} and ${xs.at(-1)}` : xs[0]);
---
<Base
  title="About Nazir and Company, Lahore"
  description={`Nazir and Company, Lahore: founded in ${company.founded}, incorporated on ${company.incorporated_text}, holder of Licence No. 1 of the Pakistan Engineering Council. Heritage and registration.`}
  heroPhoto="tower-sky"
>
  <PageHero
    photo="tower-sky"
    eyebrow="About Nazir and Company"
    lede="For more than six decades, Nazir and Company has built the high-voltage networks, substations and civil infrastructure for utilities, industry and government."
  >
    <Fragment slot="title">Electrical and Civil Engineering Contractors</Fragment>
  </PageHero>

  <section class="sec lined" id="heritage" aria-labelledby="heritage-h">
    <div class="w lg">
      <div class="lgt">
        <span class="eb">Heritage</span>
        <h2 class="h" id="heritage-h">Six Decades of Delivery</h2>
        <p class="body-grey">
          {f.name} founded the company in Lahore in {company.founded}. It was incorporated as a private limited company on {company.incorporated_text}, and holds Licence No. 1 of the Pakistan Engineering Council, the first the Council ever issued.
        </p>
        <p class="body-grey">
          By the late 1970s the company was building high-voltage transmission in Iraq and Libya. It has since delivered across {numberWord(stats.countries).toLowerCase()} countries in Asia, the Middle East and Africa, for national utilities, energy producers and governments.
        </p>
        <div class="heads">
          <div class="head">
            <Portrait name="founder" alt="" width={72} />
            <div><b>{f.name}</b><span>Founder, {f.born}–{f.died}</span></div>
          </div>
          <div class="head">
            <Portrait name="director" alt="" width={72} />
            <div><b>{d.name}</b><span>{d.title}</span></div>
          </div>
        </div>
      </div>
      <Decades />
    </div>
  </section>

  <section class="sb on-dark" aria-label="Key figures">
    <ul class="w sg">
      <li><span class="sg-n">{company.founded}</span><span class="sg-l">Founded in Lahore</span></li>
      <li><span class="sg-n">{stats.countries}</span><span class="sg-l">Countries across Asia, the Middle East and Africa</span></li>
      <li><span class="sg-n">{MAX_AC_KV}<small>kV</small></span><span class="sg-l">Transmission capability, up to HVDC</span></li>
      <li><span class="sg-n">No. 1</span><span class="sg-l">Licence of the Pakistan Engineering Council</span></li>
    </ul>
  </section>

  <section class="sec sec--soft" id="registration" aria-labelledby="reg-h">
    <div class="w grid2 top">
      <div>
        <span class="eb">Registration</span>
        <h2 class="h" id="reg-h">Licence No. 1</h2>
        <p class="lede reg-l">
          {company.pec.statement}, the first licence the Council issued. The company was incorporated as a private limited company on {company.incorporated_text}.
        </p>
      </div>
      <div>
        <ul class="regs regs--stack">
          <li><b>Pakistan Engineering Council</b> · Licence No. 1</li>
          <li><b>Pre-qualified</b> · {company.prequalified_short.join(' · ')}</li>
        </ul>
        <p class="body-grey fin">Projects financed by the {list(company.financiers)}.</p>
        <p class="body-grey">The licence covers electrical, civil, mechanical and building works. <a href="/capabilities/#licence">Licensed fields</a>.</p>
      </div>
    </div>
  </section>

  <Statement
    text={`The company is led by its Director, ${d.name}, with the support of senior advisers and a developed network of engineers across Pakistan.`}
    link={{ href: '/leadership/', label: 'Meet the Leadership' }}
  >
    The People Behind the Delivery
  </Statement>
</Base>

<style>
  .top {
    align-items: start;
  }
  .reg-l {
    margin-top: 2rem;
  }
  .regs--stack {
    flex-direction: column;
    margin-top: 0;
    font-size: 1.1875rem;
  }
  .regs--stack li {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line-strong);
  }
  .fin {
    margin-top: 2rem;
  }
</style>
