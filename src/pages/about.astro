---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { company, projects, stats, projectBySlug, projectUrl, countries } from '../lib/data';

// Route profile: cumulative documented projects by completion year (build-time SVG)
const W = 960;
const H = 260;
const padL = 44;
const padR = 20;
const padT = 24;
const padB = 40;
const x0 = company.founded;
const x1 = new Date().getFullYear();
const dated = projects.filter((p) => p.year_end !== null);
const undated = projects.length - dated.length;
const X = (y: number) => padL + ((y - x0) / (x1 - x0)) * (W - padL - padR);
const Y = (n: number) => H - padB - (n / dated.length) * (H - padT - padB);
let cum = 0;
const pts: [number, number][] = [[X(x0), Y(0)]];
for (let y = x0; y <= stats.lastYear; y++) {
  const n = dated.filter((p) => p.year_end === y).length;
  if (n) {
    pts.push([X(y), Y(cum)]);
    cum += n;
    pts.push([X(y), Y(cum)]);
  }
}
pts.push([X(x1), Y(cum)]);
const line = pts.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`).join('');
const area = `${line}L${X(x1).toFixed(1)} ${Y(0)}L${X(x0)} ${Y(0)}Z`;
const decadeTicks = [1960, 1970, 1980, 1990, 2000, 2010, 2020];

const f = (slug: string) => projectBySlug(slug);
const stations = [
  { year: '1958', title: 'Founded', text: `Established by ${company.founder.name}.` },
  { year: '1970s', title: 'Work outside Pakistan begins', text: 'The company begins work in other countries.' },
  { year: '1972', title: 'Incorporated', text: `Incorporated as a private limited company on ${company.incorporated_text}, working in civil, electrical and mechanical engineering.` },
  { year: '1977', title: 'First documented completions', text: '500 kV Tarbela–Faisalabad line foundations in Pakistan; 132 kV lines from Dukan in Iraq.' },
  { year: '1978', title: 'First documented projects in Libya', text: 'Civil works for desalination plants and for 30/10 kV substations.' },
  { year: '1979', title: 'Saudi Arabia and Iran', text: '110 kV Makkah–Taif line extension; stringing of the 230 kV Shiraz–Bushehr line.' },
  { year: '1980', title: '220 kV and 400 kV', text: 'Misurata–Sirte 220 kV lines and the Tripoli ring in Libya; the 358 km Nasiriya–Wasit–Baghdad 400 kV line in Iraq.', href: projectUrl(f('misurata-sirte-220-kv-lines-and-tripoli-ring')) },
  { year: '1985', title: 'Sheikh Tanveer Ahmed joins', text: 'The present Director joins the company.' },
  { year: '1997', title: 'HVDC in Mozambique', text: 'Work on the ±533 kV Songo–Apollo HVDC line for Consorzio Italia 2000.', href: projectUrl(f('songo-apollo-533-kv-hvdc-transmission-line')) },
  { year: '1998', title: '500 kV in Malaysia', text: 'Erection and stringing of double-circuit 500 kV lines for Tenaga Nasional Berhad.', href: projectUrl(f('ayer-tawar-junjung-500-kv-double-circuit-line-80-km')) },
  { year: '2001', title: '750 km in Libya', text: 'Turnkey 220 kV double-circuit lines from Benghazi to the eastern border.', href: projectUrl(f('benghazi-eastern-border-220-kv-double-circuit-lines-750-km')) },
  { year: '2005', title: 'The founder dies', text: `${company.founder.name} (${company.founder.born}–${company.founder.died}).` },
  { year: '2007', title: 'Barotha–Rewat 500 kV', text: 'Transmission lines for the national grid in Pakistan.', href: projectUrl(f('barotha-rewat-500-kv-transmission-lines')) },
  { year: '2011', title: 'Samnu–Sebha 220 kV', text: 'Double-circuit twin-bundle line for GECOL, the latest documented Libyan project.', href: projectUrl(f('samnu-sebha-220-kv-double-circuit-twin-bundle-line')) },
  { year: '2014', title: '380 kV turnkey in Saudi Arabia', text: '380/110 kV overhead lines and a fibre-optic network in the Makkah, Taif and Madinah area.', href: projectUrl(f('380-110-kv-overhead-lines-and-fibre-optic-network-makkah-taif-and-madinah')) },
  { year: '2020', title: 'Latest documented project', text: 'Infrastructure for Fatima Jinnah Town, Multan, for the Multan Development Authority.' },
];
---
<Base title="About" description={`Nazir and Company, founded ${company.founded} and incorporated ${company.incorporated_text}: the company's history, founder and present work.`}>
  <header class="page-head">
    <div class="container">
      <p class="eyebrow">About</p>
      <h1>From 1958 to today</h1>
      <p class="lede">
        Nazir and Company (Pvt) Ltd is an electrical and civil engineering contractor based in Lahore. It was founded in
        {company.founded} and incorporated in 1972. Its documented record runs from {stats.firstYear} to {stats.lastYear}
        across {stats.countries} countries.
      </p>
    </div>
  </header>

  <section class="section" aria-labelledby="profile-h">
    <div class="container">
      <p class="eyebrow">Route profile</p>
      <h2 id="profile-h">Documented projects over time</h2>
      <figure class="profile">
        <svg viewBox={`0 0 ${W} ${H}`} width={W} height={H} role="img" aria-labelledby="pf-t pf-d">
          <title id="pf-t">Cumulative number of documented projects by completion year, {x0} to {x1}</title>
          <desc id="pf-d">{`The line rises from the first documented completions in ${stats.firstYear} to ${cum} dated projects by ${stats.lastYear}.`}</desc>
          <g stroke="var(--rule)" stroke-width="1">
            {[0.25, 0.5, 0.75, 1].map((k) => <path d={`M${padL} ${Y(dated.length * k).toFixed(1)}H${W - padR}`} />)}
          </g>
          <path d={area} fill="rgba(11,31,58,0.06)" />
          <path d={line} fill="none" stroke="var(--navy)" stroke-width="2" stroke-linejoin="round" />
          <path d={`M${padL} ${Y(0)}H${W - padR}`} stroke="var(--navy)" stroke-width="1" />
          <g font-family="IBM Plex Mono, Plex Mono Fallback, monospace" font-size="12" fill="var(--muted)">
            {decadeTicks.map((y) => (
              <>
                <path d={`M${X(y).toFixed(1)} ${Y(0)}v6`} stroke="var(--navy)" />
                <text x={X(y)} y={H - padB + 20} text-anchor="middle">{y}</text>
              </>
            ))}
            <text x={padL - 8} y={Y(dated.length) + 4} text-anchor="end">{dated.length}</text>
            <text x={padL - 8} y={Y(0) + 4} text-anchor="end">0</text>
          </g>
          <g font-family="IBM Plex Mono, Plex Mono Fallback, monospace" font-size="12" fill="var(--navy)">
            {[
              [company.founded, 'Founded 1958'],
              [1972, 'Incorporated'],
              [2001, '750 km, Libya'],
            ].map(([y, label]) => (
              <>
                <circle cx={X(y as number)} cy={Y(0)} r="4" fill="var(--amber)" stroke="var(--paper)" stroke-width="2" />
                <text x={X(y as number) + 6} y={Y(0) - 10}>{label}</text>
              </>
            ))}
            <text x={X(stats.lastYear) - 6} y={Y(cum) - 10} text-anchor="end" font-weight="500">{cum} projects by {stats.lastYear}</text>
          </g>
        </svg>
        <figcaption>
          Cumulative count by completion year, from the project register.{undated > 0 && ` ${undated} projects without a stated year are not plotted.`}
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="tl-h">
    <div class="container">
      <h2 id="tl-h">Stations along the way</h2>
      <ol class="route">
        {stations.map((s) => (
          <li>
            <span class="ch fig">{s.year}</span>
            <div>
              <h3>{s.href ? <a href={s.href}>{s.title}</a> : s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="founder-h">
    <div class="container two-col">
      <div>
        <p class="eyebrow">The founder</p>
        <h2 id="founder-h">{company.founder.name}, {company.founder.born}–{company.founder.died}</h2>
        <ul class="prose-list">
          {company.founder.facts.map((t) => <li>{t}</li>)}
        </ul>
        <p><a href="/leadership/">Leadership and team</a></p>
      </div>
      <div class="plaque" aria-hidden="true">
        <Logo height={80} />
        <p class="fig">EST. {company.founded}</p>
      </div>
    </div>
  </section>

  <section class="section section--navy" aria-labelledby="today-h">
    <div class="container">
      <p class="eyebrow">Today</p>
      <h2 id="today-h">What the company is today</h2>
      <ul class="today">
        <li>Head office at 100 Abu Bakr Block, New Garden Town, Lahore.</li>
        <li>{company.pec.statement}. The company was the first licence holder of the Pakistan Engineering Council.</li>
        <li>Holds enlistment letters from Punjab and Khyber Pakhtunkhwa authorities, DHA Lahore and the National Highway Authority, dated 2011 to 2018. <a href="/capabilities/">Capabilities and compliance</a>.</li>
        <li>Directed by Sheikh Tanveer Ahmed, with the company since 1985.</li>
        <li>{company.libya_status}</li>
        <li>A documented record of {stats.projects} projects in {countries.map((c) => c.name).join(', ')}.</li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .profile {
    margin: 0;
    border: 1px solid var(--navy);
    background: var(--panel);
    padding: 0.75rem;
  }
  .profile svg {
    display: block;
    width: 100%;
    height: auto;
    min-height: 9rem;
  }
  .profile figcaption {
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--rule);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .route {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .route::before {
    content: '';
    position: absolute;
    left: 3.75rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--navy);
  }
  .route li {
    position: relative;
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    gap: 1.25rem;
    padding: 0.5rem 0 1rem;
  }
  .route li::before {
    content: '';
    position: absolute;
    left: calc(3.75rem - 5px);
    top: 0.85rem;
    width: 12px;
    height: 12px;
    background: var(--amber);
    border: 2px solid var(--paper);
    border-radius: 50%;
  }
  .ch {
    color: var(--navy);
    padding-top: 0.2rem;
    font-size: 0.9375rem;
  }
  .route h3 {
    font-size: var(--step-1);
    margin-bottom: 0.2rem;
    padding-left: 0.5rem;
  }
  .route p {
    margin: 0;
    padding-left: 0.5rem;
  }
  .route h3 a {
    display: inline-block;
    padding-block: 0.4rem;
  }
  .plaque {
    border: 1px solid var(--navy);
    background: var(--panel);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: var(--navy);
  }
  .plaque p {
    margin: 0;
    letter-spacing: 0.2em;
  }
  .prose-list li {
    margin-bottom: 0.4rem;
  }
  .today li {
    margin-bottom: 0.6rem;
    max-width: 70ch;
  }
</style>
