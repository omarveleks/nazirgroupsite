---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Portrait from '../components/Portrait.astro';
import Decades from '../components/Decades.astro';
import Leadership from '../components/Leadership.astro';
import Advisers from '../components/Advisers.astro';
import Engineers from '../components/Engineers.astro';
import Statement from '../components/Statement.astro';
import Go from '../components/Go.astro';
import { company, stats } from '../lib/data';
import { MAX_AC_KV, numberWord } from '../lib/site';

const d = company.director;
const f = company.founder;
---
<Base
  title="About"
  description={`Nazir and Company, Lahore: founded in ${company.founded}, incorporated on ${company.incorporated_text}, holder of Licence No. 1 of the Pakistan Engineering Council. Heritage, leadership and engineers.`}
  heroPhoto="tower-sky"
>
  <PageHero
    photo="tower-sky"
    eyebrow="About Nazir and Company"
    lede="For more than six decades, Nazir and Company has built the high-voltage networks, substations and civil infrastructure that power economies."
  >
    <Fragment slot="title">Delivering the Infrastructure Nations Run On</Fragment>
  </PageHero>

  <section class="sec lined" id="heritage" aria-labelledby="heritage-h">
    <div class="w lg">
      <div class="lgt">
        <span class="eb">Heritage</span>
        <h2 class="h" id="heritage-h">Six Decades of Delivery</h2>
        <p class="body-grey">
          {f.name} founded the company in Lahore in {company.founded}. It was incorporated as a private limited company on {company.incorporated_text}, and holds Licence No. 1 of the Pakistan Engineering Council, the first the Council ever issued.
        </p>
        <p class="body-grey">
          By the late 1970s the company was building high-voltage transmission in Iraq and Libya. It has since delivered across {numberWord(stats.countries).toLowerCase()} countries in Asia, the Middle East and Africa, for national utilities, energy producers and governments.
        </p>
        <div class="heads">
          <div class="head">
            <Portrait name="founder" alt="" width={72} />
            <div><b>{f.name}</b><span>Founder, {f.born}–{f.died}</span></div>
          </div>
          <div class="head">
            <Portrait name="director" alt="" width={72} />
            <div><b>{d.name}</b><span>{d.title}</span></div>
          </div>
        </div>
      </div>
      <Decades />
    </div>
  </section>

  <section class="sb on-dark" aria-label="Key figures">
    <ul class="w sg">
      <li><span class="sg-n">{company.founded}</span><span class="sg-l">Founded in Lahore</span></li>
      <li><span class="sg-n">{stats.countries}</span><span class="sg-l">Countries across Asia, the Middle East and Africa</span></li>
      <li><span class="sg-n">{MAX_AC_KV}<small>kV</small></span><span class="sg-l">Transmission capability, up to HVDC</span></li>
      <li><span class="sg-n">No. 1</span><span class="sg-l">Licence of the Pakistan Engineering Council</span></li>
    </ul>
  </section>

  <section class="sec" id="leadership" aria-labelledby="leadership-h">
    <div class="w">
      <div class="grid2 head-row">
        <div>
          <span class="eb">Leadership</span>
          <h2 class="h" id="leadership-h">Leadership</h2>
        </div>
        <p class="body-grey">The company is led by its Director, {d.name}, with the support of a team of senior advisers.</p>
      </div>
      <Leadership />
    </div>
  </section>

  <section class="sec sec--soft" aria-labelledby="advisers-h">
    <div class="w">
      <span class="eb">Advisers</span>
      <h2 class="h head-row" id="advisers-h">Key Advisers</h2>
      <Advisers />
    </div>
  </section>

  <section class="sec" id="engineers" aria-labelledby="engineers-h">
    <div class="w">
      <div class="grid2 head-row">
        <div>
          <span class="eb">Engineers</span>
          <h2 class="h" id="engineers-h">Selected Engineers</h2>
        </div>
        <p class="body-grey">Engineers registered with the Pakistan Engineering Council and listed on the company licence. The full technical team is available on request.</p>
      </div>
      <Engineers />
      <div class="row-links more"><Go href="/leadership/" label="Leadership and Team" /></div>
    </div>
  </section>

  <Statement text="Discuss transmission, substation and infrastructure programmes with the business development team." link={{ href: '/contact/?type=partnership', label: 'Contact' }}>
    Partner With Nazir and Company
  </Statement>
</Base>

<style>
  .more {
    margin-top: 3.5rem;
  }
</style>
