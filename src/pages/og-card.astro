---
// Build-only page: rendered to public/og/nazir.png by scripts/make-assets.mjs,
// then removed from dist by scripts/postbuild.mjs. Never deployed.
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import HeroDrawing from '../components/HeroDrawing.astro';
import { stats } from '../lib/data';
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>OG card</title>
  </head>
  <body>
    <div class="card">
      <div class="l">
        <Logo height={70} />
        <p class="name">Nazir and Company</p>
        <p class="tag">Electrical and civil engineering contractor · Lahore · since {stats.founded}</p>
        <ul>
          <li><span class="fig">{stats.projects}</span> projects documented</li>
          <li><span class="fig">{stats.countries}</span> countries</li>
          <li><span class="fig">750 km</span> 220 kV line, Libya, 2001</li>
        </ul>
      </div>
      <div class="r"><HeroDrawing labels={false} /></div>
    </div>
  </body>
</html>
<style>
  body {
    margin: 0;
  }
  .card {
    width: 1200px;
    height: 630px;
    box-sizing: border-box;
    padding: 64px;
    display: grid;
    grid-template-columns: 520px 1fr;
    gap: 32px;
    align-items: center;
    background: var(--paper);
    color: var(--navy);
    border-bottom: 14px solid var(--navy);
  }
  .name {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 58px;
    line-height: 1.05;
    margin: 28px 0 12px;
  }
  .tag {
    font-size: 22px;
    color: var(--muted);
    margin: 0 0 28px;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 22px;
    border-top: 1px solid var(--navy);
  }
  li {
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
  }
  .fig {
    font-size: 26px;
    margin-right: 8px;
  }
  .r :global(svg) {
    width: 100%;
    height: auto;
    animation: none;
  }
</style>
