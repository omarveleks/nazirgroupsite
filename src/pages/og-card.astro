---
// Build-only page: rendered to public/og/nazir.png by scripts/make-assets.mjs,
// then removed from dist by scripts/postbuild.mjs. Never deployed.
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { company } from '../lib/data';
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>OG card</title>
  </head>
  <body>
    <div class="card">
      <img src="/images/photos/tower-sky-1600.jpg" alt="" width="1600" height="689" />
      <div class="t">
        <Logo height={60} />
        <p class="h1">Electrical and Civil Engineering<br />Since {company.founded}</p>
        <p class="sub">Transmission, substations and infrastructure across Asia, the Middle East and Africa</p>
      </div>
      <span class="bar"></span>
    </div>
  </body>
</html>
<style>
  body {
    margin: 0;
  }
  .card {
    position: relative;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    background: #081428;
    color: #fff;
  }
  .card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 74% 40%;
  }
  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(8, 16, 28, 0.9), rgba(8, 16, 28, 0.55) 55%, rgba(8, 16, 28, 0.15));
  }
  .t {
    position: absolute;
    z-index: 2;
    left: 72px;
    top: 64px;
    right: 470px;
  }
  .t :global(.logo) {
    color: #fff;
  }
  .h1 {
    margin: 64px 0 24px;
    font: 300 84px/1 var(--display);
    letter-spacing: -0.035em;
  }
  .sub {
    margin: 0;
    font: 300 24px/1.4 var(--body);
    color: rgba(255, 255, 255, 0.88);
  }
  .bar {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: 0;
    height: 12px;
    background: var(--blue);
  }
</style>
