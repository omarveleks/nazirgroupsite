---
// Build-only layout for the downloadable PDFs. Pages under /print/ are rendered to
// public/downloads/*.pdf by scripts/make-pdfs.mjs (Chromium print), then removed from
// dist by scripts/postbuild.mjs. Same fonts, colours and photos as the website.
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <style is:inline>
      @page {
        size: A4;
        margin: 0;
      }
      html,
      body {
        margin: 0;
        background: #fff;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      body {
        font: 300 9.5pt/1.6 var(--body);
        color: var(--slate);
      }
      .page {
        position: relative;
        width: 210mm;
        height: 297mm;
        overflow: hidden;
        break-after: page;
        background: #fff;
      }
      .page:last-child {
        break-after: auto;
      }
      .pad {
        position: absolute;
        inset: 0;
        padding: 20mm 18mm 26mm;
        overflow: hidden;
      }
      .dark {
        background: var(--ink);
        color: #fff;
      }
      .pfoot {
        position: absolute;
        left: 18mm;
        right: 18mm;
        bottom: 11mm;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 3mm;
        border-top: 0.6pt solid var(--line);
        font: 400 7pt/1 var(--body);
        letter-spacing: 0.04em;
        color: var(--grey);
      }
      .dark .pfoot {
        border-top-color: rgba(255, 255, 255, 0.2);
        color: rgba(255, 255, 255, 0.75);
      }
      .pfoot b {
        font: 600 7pt/1 var(--display);
        letter-spacing: 0.14em;
        color: var(--blue);
      }
      .dark .pfoot b {
        color: var(--sky);
      }
      .p-eb {
        display: block;
        margin: 0 0 4mm;
        font: 600 7.5pt/1.3 var(--display);
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--blue);
      }
      .dark .p-eb,
      .on-photo .p-eb {
        color: var(--sky);
      }
      .p-h1 {
        margin: 0;
        font: 300 40pt/1.02 var(--display);
        letter-spacing: -0.035em;
        color: var(--ink);
      }
      .p-h2 {
        margin: 0;
        font: 300 26pt/1.06 var(--display);
        letter-spacing: -0.03em;
        color: var(--ink);
      }
      .p-h3 {
        margin: 0;
        font: 400 13pt/1.2 var(--display);
        letter-spacing: -0.015em;
        color: var(--ink);
      }
      .dark .p-h1,
      .dark .p-h2,
      .dark .p-h3,
      .on-photo .p-h1,
      .on-photo .p-h2 {
        color: #fff;
      }
      .p-lede {
        margin: 6mm 0 0;
        font: 300 12pt/1.55 var(--body);
        color: var(--grey);
        max-width: 125mm;
      }
      .dark .p-lede,
      .on-photo .p-lede {
        color: rgba(255, 255, 255, 0.88);
      }
      .p-body {
        margin: 0 0 3mm;
        color: var(--grey);
      }
      .rule {
        height: 0;
        margin: 8mm 0;
        border: 0;
        border-top: 0.6pt solid var(--line);
      }
      .ph {
        position: relative;
        overflow: hidden;
        border-radius: 1.6mm;
        background: var(--ink);
      }
      .ph img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .ph-cap {
        margin-top: 2mm;
        font: 400 6.5pt/1.3 var(--body);
        color: var(--grey);
      }
      .bleed {
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        overflow: hidden;
      }
      .bleed img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
      .shade::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(0deg, rgba(8, 16, 28, 0.9) 0, rgba(8, 16, 28, 0.45) 55%, rgba(8, 16, 28, 0.15));
      }
      .on-photo {
        position: absolute;
        z-index: 2;
        left: 18mm;
        right: 18mm;
        color: #fff;
      }
      .figs {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 6mm;
        list-style: none;
        margin: 0;
        padding: 9mm 10mm;
        border-radius: 1.6mm;
        background: var(--blue);
        color: #fff;
      }
      .figs .n {
        display: block;
        font: 300 26pt/1 var(--display);
        letter-spacing: -0.04em;
      }
      .figs .n small {
        font-size: 0.4em;
        font-weight: 400;
        letter-spacing: 0;
        margin-left: 1mm;
      }
      .figs .l {
        display: block;
        margin-top: 2.5mm;
        font: 300 8pt/1.4 var(--body);
        color: rgba(255, 255, 255, 0.88);
      }
      .pfacts {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0 5mm;
        margin: 0;
      }
      .pfacts div {
        padding: 1.8mm 0;
        border-top: 0.6pt solid var(--line);
      }
      .pfacts dt {
        font: 600 6pt/1.2 var(--display);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--grey);
      }
      .pfacts dd {
        margin: 0.8mm 0 0;
        font: 300 8.5pt/1.3 var(--display);
        color: var(--ink);
      }
      .num {
        font: 400 8pt/1 var(--display);
        letter-spacing: 0.1em;
        color: var(--blue);
      }
      .clean {
        list-style: none;
        margin: 0;
        padding: 0;
      }
    </style>
  </head>
  <body class="pdoc">
    <slot />
  </body>
</html>
