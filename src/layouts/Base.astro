---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import ContactDetails from '../components/ContactDetails.astro';
import { SITE_MODE, company, stats } from '../lib/data';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  current?: string;
}

const { title, description, ogImage = '/og/nazir.png', jsonLd = [], noindex = false, current } = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const fullTitle = Astro.url.pathname === '/' ? title : `${title} | Nazir and Company`;
const robots = SITE_MODE === 'review' || noindex ? 'noindex, nofollow' : 'index, follow';
const nav = [
  { href: '/projects/', label: 'Projects' },
  { href: '/services/', label: 'Services' },
  { href: '/libya/', label: 'Libya' },
  { href: '/about/', label: 'About' },
  { href: '/capabilities/', label: 'Capabilities' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => (current ? current === href : path === href || (href !== '/' && path.startsWith(href)));
const year = new Date().getFullYear();

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/#organization', site).href,
  name: company.name,
  alternateName: 'Nazir & Company (Pvt) Ltd',
  url: new URL('/', site).href,
  logo: new URL('/icons/icon-512.png', site).href,
  foundingDate: String(company.founded),
  founder: { '@type': 'Person', name: company.founder.name },
  address: {
    '@type': 'PostalAddress',
    streetAddress: '100 Abu Bakr Block, New Garden Town',
    addressLocality: 'Lahore',
    addressCountry: 'PK',
  },
  description: `Electrical and civil engineering contractor, founded in ${company.founded}, with ${stats.projects} documented projects in ${stats.countries} countries.`,
};
const ld = [org, ...jsonLd];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b1f3a" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nazir and Company" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Line drawing of a 220 kV transmission tower with the Nazir logo" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    {ld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href="/" aria-label="Nazir and Company, home">
          <Logo height={38} />
          <span class="brand-name">Nazir and Company</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <ul class="nav-desktop">
            {nav.map((n) => (
              <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
          <details class="nav-mobile">
            <summary>
              <span class="burger" aria-hidden="true"><span></span></span>
              <span>Menu</span>
            </summary>
            <ul class="nav-panel">
              {nav.map((n) => (
                <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
              ))}
            </ul>
          </details>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container foot">
        <div class="foot-brand">
          <Logo height={44} />
          <p class="foot-name">{company.name}</p>
          <p class="muted-light">Electrical and civil engineering contractor. Founded {company.founded}. Incorporated {company.incorporated_text}.</p>
          <p class="muted-light">{company.pec.statement}.</p>
        </div>
        <div>
          <h2 class="foot-h">Office</h2>
          <ContactDetails variant="footer" />
        </div>
        <div>
          <h2 class="foot-h">Company</h2>
          <ul class="foot-links">
            <li><a href="/about/">About</a></li>
            <li><a href="/leadership/">Leadership and team</a></li>
            <li><a href="/capabilities/">Capabilities and compliance</a></li>
            <li><a href="/services/">Services</a></li>
            <li><a href="/contact/">Contact</a></li>
          </ul>
        </div>
        <div>
          <h2 class="foot-h">Record</h2>
          <ul class="foot-links">
            <li><a href="/projects/">Project register</a></li>
            <li><a href="/global-presence/">Global presence</a></li>
            <li><a href="/libya/">Libya</a></li>
            <li><a href="/downloads/">Downloads</a></li>
          </ul>
        </div>
      </div>
      <div class="container foot-base">
        <p>© {year} {company.name}</p>
        <ul class="foot-links foot-links--inline">
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/accessibility/">Accessibility</a></li>
        </ul>
      </div>
    </footer>
    <script src="../scripts/menu.ts"></script>
  </body>
</html>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    background: var(--paper);
    border-bottom: 1px solid var(--navy);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    min-height: 4rem;
    padding-block: 0.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--navy);
    text-decoration: none;
    min-height: 2.75rem;
  }
  .brand-name {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.1;
  }
  @media (max-width: 23rem) {
    .brand-name {
      display: none;
    }
  }
  .nav-desktop {
    display: none;
  }
  .nav-desktop,
  .nav-panel {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-desktop {
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0 0.25rem;
  }
  .nav-desktop a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.7rem;
    text-decoration: none;
    font-weight: 600;
    color: var(--navy);
    border-bottom: 2px solid transparent;
  }
  .nav-desktop a:hover {
    border-bottom-color: var(--amber);
  }
  .nav-desktop a[aria-current='page'] {
    border-bottom-color: var(--navy);
  }
  .nav-mobile {
    position: static;
  }
  .nav-mobile summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    min-width: 2.75rem;
    padding: 0 0.75rem;
    border: 1px solid var(--navy);
    border-radius: var(--radius);
    cursor: pointer;
    font-weight: 600;
    color: var(--navy);
  }
  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }
  .burger {
    position: relative;
    width: 18px;
    height: 12px;
    border-top: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
  }
  .burger span {
    position: absolute;
    left: 0;
    right: 0;
    top: 3px;
    height: 2px;
    background: currentColor;
  }
  .nav-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--paper);
    border-bottom: 1px solid var(--navy);
    box-shadow: 0 12px 24px rgba(11, 31, 58, 0.12);
  }
  .nav-mobile li {
    border-top: 1px solid var(--rule);
  }
  .nav-mobile a {
    display: flex;
    align-items: center;
    min-height: 3rem;
    padding: 0 max(1rem, env(safe-area-inset-left));
    font-weight: 600;
    text-decoration: none;
  }
  .nav-mobile a[aria-current='page'] {
    box-shadow: inset 4px 0 0 var(--amber);
  }
  @media (min-width: 60rem) {
    .nav-desktop {
      display: flex;
    }
    .nav-mobile {
      display: none;
    }
  }

  .site-footer {
    background: var(--navy);
    color: var(--paper);
    margin-top: 0;
    padding-top: 3rem;
    padding-bottom: max(1rem, env(safe-area-inset-bottom));
  }
  .site-footer a {
    color: var(--paper);
  }
  .foot {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(246, 243, 236, 0.25);
  }
  @media (min-width: 48rem) {
    .foot {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    }
  }
  .foot > * {
    min-width: 0;
  }
  .foot-name {
    font-family: var(--serif);
    font-size: 1.25rem;
    margin: 0.75rem 0 0.5rem;
  }
  .muted-light {
    color: var(--mist);
    font-size: var(--step--1);
  }
  .foot-h {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--amber);
    margin-bottom: 0.75rem;
  }
  .foot-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .foot-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
  .foot-links--inline {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
  }
  .foot-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 2rem;
    padding-top: 1rem;
    font-size: var(--step--1);
    color: var(--mist);
  }
  .foot-base p {
    margin: 0;
  }
</style>
