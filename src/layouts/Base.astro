---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import ContactDetails from '../components/ContactDetails.astro';
import { SITE_MODE, company, stats } from '../lib/data';
import { photo, PHONE_MQ, WIDE_MQ } from '../lib/images';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  current?: string;
  /** Photo shown in the first screen: preloaded with the same sources as its <picture> */
  heroPhoto?: string;
}

const { title, description, ogImage = '/og/nazir.png', jsonLd = [], noindex = false, current, heroPhoto } = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const fullTitle = Astro.url.pathname === '/' ? title : `${title} | Nazir and Company`;
const robots = SITE_MODE === 'review' || noindex ? 'noindex, nofollow' : 'index, follow';
const nav = [
  { href: '/about/', label: 'About' },
  { href: '/capabilities/', label: 'Capabilities' },
  { href: '/projects/', label: 'Projects' },
  { href: '/libya/', label: 'Libya' },
];
const menu = [
  { href: '/about/', label: 'About' },
  { href: '/leadership/', label: 'Leadership' },
  { href: '/capabilities/', label: 'Capabilities' },
  { href: '/services/', label: 'Services' },
  { href: '/projects/', label: 'Projects' },
  { href: '/libya/', label: 'Libya' },
  { href: '/global-presence/', label: 'Global Presence' },
  { href: '/downloads/', label: 'Downloads' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => (current ? current === href : path === href || (href !== '/' && !href.includes('?') && path.startsWith(href)));
const year = new Date().getFullYear();
const hero = heroPhoto ? photo(heroPhoto) : null;

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': new URL('/#organization', site).href,
  name: company.name,
  alternateName: 'Nazir & Company (Pvt) Ltd',
  url: new URL('/', site).href,
  logo: new URL('/icons/icon-512.png', site).href,
  foundingDate: String(company.founded),
  founder: { '@type': 'Person', name: company.founder.name },
  address: {
    '@type': 'PostalAddress',
    streetAddress: '100 Abu Bakr Block, New Garden Town',
    addressLocality: 'Lahore',
    addressCountry: 'PK',
  },
  description: `Electrical and civil engineering contractor, founded in ${company.founded}, with projects in ${stats.countries} countries.`,
};
const ld = [org, ...jsonLd];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0b1b2e" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {hero && (
      <>
        <link rel="preload" as="image" type="image/avif" media={PHONE_MQ} imagesrcset={hero.phone('avif')} imagesizes="100vw" fetchpriority="high" />
        <link rel="preload" as="image" type="image/avif" media={WIDE_MQ} imagesrcset={hero.wide('avif')} imagesizes="100vw" fetchpriority="high" />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nazir and Company" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Nazir and Company: Built to Last Since 1958" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    {ld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="hd">
      <div class="hd-in">
        <a class="hd-logo" href="/" aria-label="Nazir and Company, home">
          <Logo height={42} />
        </a>
        <nav class="nl" aria-label="Main">
          <ul class="nl-links">
            {nav.map((n) => (
              <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
          <a class="nl-sec" href="/contact/?type=partnership">Partner With Nazir</a>
          <details class="menu nav-mobile">
            <summary>
              <span>Menu</span>
              <span class="hb-i" aria-hidden="true"><b></b><b></b><b></b></span>
            </summary>
            <div class="nav-panel on-dark">
              <div class="w mp">
                <ul class="mp-main">
                  {menu.map((n) => (
                    <li><a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a></li>
                  ))}
                </ul>
                <div class="mp-side">
                  <a class="pill pill--light" href="/contact/?type=partnership">Partner With Nazir <Icon name="right" /></a>
                  <ContactDetails variant="footer" />
                </div>
              </div>
            </div>
          </details>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="ft">
      <div class="w">
        <div class="ft-top">
          <p class="ft-tag">Built to Last<br /><span>Since {company.founded}</span></p>
          <div class="ft-cols">
            <div>
              <h2>Company</h2>
              <ul>
                <li><a href="/about/">About</a></li>
                <li><a href="/leadership/">Leadership</a></li>
                <li><a href="/about/#registration">Registration</a></li>
                <li><a href="/downloads/">Downloads</a></li>
              </ul>
            </div>
            <div>
              <h2>Capabilities</h2>
              <ul>
                <li><a href="/services/#transmission">Transmission</a></li>
                <li><a href="/services/#substations">Substations</a></li>
                <li><a href="/services/#distribution">Distribution</a></li>
                <li><a href="/services/#civil">Infrastructure</a></li>
              </ul>
            </div>
            <div>
              <h2>Projects</h2>
              <ul>
                <li><a href="/projects/#featured">Featured</a></li>
                <li><a href="/projects/#countries">By Country</a></li>
                <li><a href="/libya/">Libya</a></li>
                <li><a href="/global-presence/">Global Presence</a></li>
              </ul>
            </div>
            <div>
              <h2>Contact</h2>
              <ul>
                <li><a href="/contact/?type=partnership">Business Development</a></li>
                <li><a href="/contact/?type=careers">Careers</a></li>
              </ul>
              <ContactDetails variant="footer" />
            </div>
          </div>
        </div>
        <div class="ft-base">
          <Logo height={36} />
          <p class="ft-copy">© {year} {company.name}</p>
          <ul>
            <li><a href="/privacy/">Privacy</a></li>
            <li><a href="/accessibility/">Accessibility</a></li>
          </ul>
        </div>
      </div>
    </footer>
    <script src="../scripts/menu.ts"></script>
    <script src="../scripts/ui.ts"></script>
  </body>
</html>

<style>
  .hd-logo :global(.logo) {
    color: #fff;
    width: 5.5rem;
    height: auto;
  }
  .ft-base :global(.logo) {
    color: #fff;
    width: 5.75rem;
    height: auto;
  }
  .ft-copy {
    margin: 0;
  }
</style>
