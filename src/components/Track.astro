---
// Horizontal scroll-snap row of photo cards with "1 – 3 of N" controls (src/scripts/ui.ts).
import ProjectCard from './ProjectCard.astro';
import Icon from './Icon.astro';
import type { Slide } from '../lib/site';

interface Props {
  items: (Slide & { sub?: string })[];
  label: string;
}
const { items, label } = Astro.props;
const n = items.length;
---
<div data-track>
  <ul class="track" data-track-list aria-label={label}>
    {items.map((it) => (
      <li><ProjectCard item={it} /></li>
    ))}
  </ul>
  <div class="w track-foot">
    <div class="prog" aria-hidden="true"><b data-prog></b></div>
    <div class="tnav">
      <button type="button" data-prev aria-label="Previous"><Icon name="left" /></button>
      <span data-count aria-live="polite">1 – {Math.min(3, n)} of {n}</span>
      <button type="button" data-next aria-label="Next"><Icon name="right" /></button>
    </div>
  </div>
</div>
