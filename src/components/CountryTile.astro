---
import type { CountryInfo } from '../lib/data';
import { range } from '../lib/data';
import { outline } from '../lib/geo';

interface Props {
  c: CountryInfo;
  size?: 'large' | 'small';
}
const { c, size = 'large' } = Astro.props;
const d = outline(c.slug, 96, 72);
---
<article class={`tile tile--${size}`}>
  <svg class="marker" viewBox="0 0 96 72" width="96" height="72" aria-hidden="true" focusable="false">
    <path d={d} fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke" />
    <path d="M4 68H92" stroke="currentColor" stroke-width="0.6" stroke-dasharray="2 3" />
  </svg>
  <div class="txt">
    <h3><a href={`/projects/${c.slug}/`}>{c.name}</a></h3>
    <p class="nums">
      <span class="fig">{c.count}</span> {c.count === 1 ? 'project' : 'projects'}
      {range(c) && <span class="yr"> · <span class="fig">{range(c)}</span></span>}
    </p>
  </div>
</article>

<style>
  .tile {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    border: 1px solid var(--navy);
    background: var(--panel);
    padding: 1rem;
    transition: box-shadow var(--t) ease;
  }
  .tile:hover,
  .tile:focus-within {
    box-shadow: inset 0 -3px 0 var(--amber);
  }
  .marker {
    flex: none;
    width: 4.5rem;
    height: auto;
    color: var(--navy);
  }
  .tile--large .marker {
    width: 6rem;
  }
  h3 {
    font-size: var(--step-2);
    margin: 0 0 0.2rem;
  }
  .tile--small h3 {
    font-size: var(--step-1);
  }
  h3 a {
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .nums {
    margin: 0;
    color: var(--muted);
    font-size: var(--step--1);
  }
  .nums .fig {
    color: var(--navy);
  }
  .txt {
    min-width: 0;
  }
</style>
