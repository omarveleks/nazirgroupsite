---
// Selected engineers from the PEC licence list (src/data/engineers.json).
import PersonPlaceholder from './PersonPlaceholder.astro';
import { engineers } from '../lib/data';
const shown = engineers.shown.map((id) => engineers.engineers.find((e) => e.id === id)!);
---
<ul class="people">
  {shown.map((e) => (
    <li class="person">
      <PersonPlaceholder size={136} />
      <h3>{e.name}</h3>
      <span class="role">{e.discipline}</span>
      <p>{e.role}</p>
    </li>
  ))}
</ul>
