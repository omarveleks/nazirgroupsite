---
// "Let's Build What's Next": photo band with two white cards.
import Img from './Img.astro';
---
<section class="con on-dark" aria-labelledby="connect-h">
  <Img name="site-engineer" class="band-img" />
  <div class="w cg">
    <h2 id="connect-h">Let’s Build What’s Next</h2>
    <ul class="cc-list">
      <li>
        <a class="cc" href="/contact/?type=partnership">
          <div>
            <h3>Partner With Nazir</h3>
            <p>Discuss transmission, substation and infrastructure programmes with the business development team.</p>
          </div>
          <span class="go"><span class="go-i"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>Contact</span>
        </a>
      </li>
      <li>
        <a class="cc" href="/contact/?type=careers">
          <div>
            <h3>Build Your Career</h3>
            <p>Join the engineers and project teams delivering critical infrastructure across Asia, the Middle East and Africa.</p>
          </div>
          <span class="go"><span class="go-i"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>Careers</span>
        </a>
      </li>
    </ul>
  </div>
</section>
