---
/**
 * Schematic map of the Libyan record. Country outline from Natural Earth via
 * world-atlas; routes are straight survey lines between the named end points
 * of each line, not surveyed alignments. Marker numbers are project counts
 * computed from projects.json.
 */
import { libyaMap } from '../lib/geo';
import { country } from '../lib/data';

const m = libyaMap(720, 600);
// Named places that appear in project names (approximate coordinates, lon/lat)
const PLACES: Record<string, { lon: number; lat: number; label: string; dx?: number; dy?: number; anchor?: string }> = {
  tripoli: { lon: 13.19, lat: 32.89, label: 'Tripoli', dx: 8, dy: -8 },
  zuwara: { lon: 12.08, lat: 32.93, label: 'Zuwara', dx: -8, dy: -8, anchor: 'end' },
  zliten: { lon: 14.57, lat: 32.47, label: 'Zliten', dx: 6, dy: 14 },
  gharyan: { lon: 13.02, lat: 32.17, label: 'Gharyan', dx: -8, dy: 14, anchor: 'end' },
  jabal: { lon: 12.3, lat: 31.95, label: 'Jabal al Gharbi', dx: -8, dy: 4, anchor: 'end' },
  nalut: { lon: 10.98, lat: 31.87, label: 'Nalut', dx: 8, dy: 4 },
  ghadames: { lon: 9.5, lat: 30.13, label: 'Ghadames', dx: 8, dy: 4 },
  hamada: { lon: 12.9, lat: 29.5, label: 'Hamada field', dx: 8, dy: 4 },
  misurata: { lon: 15.09, lat: 32.38, label: 'Misurata', dx: 8, dy: -6 },
  sirte: { lon: 16.59, lat: 31.21, label: 'Sirte', dx: 8, dy: -6 },
  hun: { lon: 15.95, lat: 29.12, label: 'Hun', dx: 8, dy: 4 },
  samnu: { lon: 14.87, lat: 27.27, label: 'Samnu', dx: 8, dy: -4 },
  sebha: { lon: 14.43, lat: 27.04, label: 'Sebha', dx: -8, dy: 12, anchor: 'end' },
  raguba: { lon: 19.1, lat: 29.1, label: 'Raguba', dx: -8, dy: 4, anchor: 'end' },
  jalo: { lon: 21.55, lat: 29.03, label: 'Jalo', dx: 8, dy: 4 },
  nafoora: { lon: 21.6, lat: 29.35, label: 'Nafoora', dx: 8, dy: -4 },
  messla: { lon: 22.25, lat: 27.9, label: 'Messla', dx: 8, dy: -4 },
  sarir: { lon: 22.5, lat: 27.6, label: 'Sarir', dx: 8, dy: 12 },
  benghazi: { lon: 20.07, lat: 32.12, label: 'Benghazi', dx: -8, dy: 14, anchor: 'end' },
  tobruk: { lon: 23.96, lat: 32.08, label: 'Tobruk', dx: 0, dy: -10, anchor: 'middle' },
  border: { lon: 25.05, lat: 31.6, label: 'Eastern border', dx: -4, dy: 16, anchor: 'end' },
};
const RULES: [RegExp, string[]][] = [
  [/Samnu–Sebha/, ['samnu', 'sebha']],
  [/Hun–Wadi Arial–Samnu/, ['hun', 'samnu']],
  [/Benghazi/, ['benghazi', 'border']],
  [/Misurata–Sirte/, ['misurata', 'sirte']],
  [/Nalut–Ghadames/, ['nalut', 'ghadames']],
  [/Aziziya to Gharyan/, ['gharyan']],
  [/Tajoura|Tripoli area|Harbour site/, ['tripoli']],
  [/Zuwara, Al-Asa and Zliten/, ['zuwara', 'zliten']],
  [/Zuwara/, ['zuwara']],
  [/Jabal al Gharbi/, ['jabal']],
  [/Jalo/, ['jalo']],
  [/Nafoora/, ['nafoora']],
  [/Hamada/, ['hamada']],
  [/Raguba/, ['raguba']],
  [/Messla and Sarir|Sarir.*Messla/, ['messla']],
  [/Messla/, ['messla']],
  [/Sarir/, ['sarir']],
];
const lib = country('libya');
const counts: Record<string, number> = {};
let unlocated = 0;
for (const p of lib.projects) {
  const rule = RULES.find(([re]) => re.test(p.name) || re.test(p.scope));
  if (!rule) {
    unlocated++;
    continue;
  }
  const key = rule[1][0]!;
  counts[key] = (counts[key] ?? 0) + 1;
}
const pt = (k: string) => m.at(PLACES[k]!.lon, PLACES[k]!.lat);
const routes = [
  { d: [pt('benghazi'), pt('tobruk'), pt('border')], label: '220 kV · 750 km · 2001' },
  { d: [pt('samnu'), pt('sebha')], label: '220 kV · 2011' },
  { d: [pt('hun'), pt('samnu')], label: '220 kV · 1989' },
  { d: [pt('misurata'), pt('sirte')], label: '220 kV · 1980' },
  { d: [pt('nalut'), pt('ghadames')], label: '66 kV · 1981' },
];
const path = (pts: { x: number; y: number }[]) => pts.map((q, i) => `${i ? 'L' : 'M'}${q.x} ${q.y}`).join('');
// small tower ticks along each route
const ticks = (pts: { x: number; y: number }[]) => {
  const out: string[] = [];
  for (let i = 0; i < pts.length - 1; i++) {
    const a = pts[i]!;
    const b = pts[i + 1]!;
    const len = Math.hypot(b.x - a.x, b.y - a.y);
    const n = Math.max(1, Math.floor(len / 18));
    const nx = -(b.y - a.y) / len;
    const ny = (b.x - a.x) / len;
    for (let k = 1; k < n; k++) {
      const x = a.x + ((b.x - a.x) * k) / n;
      const y = a.y + ((b.y - a.y) * k) / n;
      out.push(`M${(x - nx * 3).toFixed(1)} ${(y - ny * 3).toFixed(1)}L${(x + nx * 3).toFixed(1)} ${(y + ny * 3).toFixed(1)}`);
    }
  }
  return out.join('');
};
const ringCentre = pt('tripoli');
const located = lib.count - unlocated;
---
<figure class="lmap">
  <svg viewBox={`0 0 ${m.w} ${m.h}`} width={m.w} height={m.h} role="img" aria-labelledby="lmap-t lmap-d">
    <title id="lmap-t">Schematic map of Libya showing the company's documented project locations</title>
    <desc id="lmap-d">
      {`Markers show where ${located} of the ${lib.count} Libyan projects were located, with the number of projects at each place. Lines show the 220 kV routes Benghazi to the eastern border, Samnu to Sebha, Hun to Samnu and Misurata to Sirte, and the 66 kV Nalut to Ghadames line.`}
    </desc>
    <path d={m.neighbours} fill="none" stroke="var(--rule-strong)" stroke-width="0.8" />
    <path d={m.libya} fill="#fbf9f4" stroke="var(--navy)" stroke-width="1.4" />
    <g fill="none" stroke="var(--amber)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
      {routes.map((r) => <path d={path(r.d)} />)}
      <circle cx={ringCentre.x} cy={ringCentre.y} r="16" stroke-dasharray="4 3" />
    </g>
    <g fill="none" stroke="var(--navy)" stroke-width="1">
      {routes.map((r) => <path d={ticks(r.d)} />)}
    </g>
    <g font-family="IBM Plex Mono, Plex Mono Fallback, monospace" font-size="12" fill="var(--navy)">
      {Object.entries(PLACES).map(([k, pl]) => {
        const q = pt(k);
        const n = counts[k];
        return (
          <g>
            {n ? (
              <>
                <circle cx={q.x} cy={q.y} r={n > 1 ? 9 : 6} fill="var(--navy)" />
                {n > 1 && <text x={q.x} y={q.y + 4} text-anchor="middle" fill="var(--paper)" font-size="10">{n}</text>}
              </>
            ) : (
              <circle cx={q.x} cy={q.y} r="3" fill="var(--paper)" stroke="var(--navy)" />
            )}
            <text x={q.x + (pl.dx ?? 8)} y={q.y + (pl.dy ?? 4)} text-anchor={pl.anchor ?? 'start'}>{pl.label}</text>
          </g>
        );
      })}
    </g>
    <g font-family="IBM Plex Mono, Plex Mono Fallback, monospace" font-size="11" fill="var(--amber-ink)">
      <text x={pt('tobruk').x - 40} y={pt('tobruk').y + 34} text-anchor="middle">{routes[0]!.label}</text>
      <text x={pt('sebha').x - 12} y={pt('sebha').y + 30} text-anchor="middle">{routes[1]!.label}</text>
      <text x={pt('hun').x + 10} y={pt('hun').y + 22}>{routes[2]!.label}</text>
      <text x={pt('sirte').x + 8} y={pt('sirte').y + 18}>{routes[3]!.label}</text>
      <text x={pt('ghadames').x + 8} y={pt('ghadames').y + 20}>{routes[4]!.label}</text>
      <text x={ringCentre.x - 20} y={ringCentre.y + 32} text-anchor="end">Tripoli ring · 220 kV · 1980</text>
    </g>
  </svg>
  <figcaption>
    Schematic. Lines join the named end points and are not surveyed alignments. {located} of {lib.count} projects are
    placed by the location named in the project title; the other {unlocated} do not name a location.
  </figcaption>
</figure>

<style>
  .lmap {
    margin: 0;
    border: 1px solid var(--navy);
    background: var(--paper);
    padding: 0.75rem;
  }
  .lmap svg {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    border-top: 1px solid var(--rule);
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    font-size: var(--step--1);
    color: var(--muted);
  }
</style>
