---
// Neutral line-art portrait placeholder. No photographs of people are used
// unless the company supplies them.
interface Props {
  size?: number;
}
const { size = 96 } = Astro.props;
---
<svg class="pp" viewBox="0 0 96 96" width={size} height={size} aria-hidden="true" focusable="false">
  <rect x="0.5" y="0.5" width="95" height="95" fill="none" stroke="currentColor" stroke-width="1" />
  <path d="M0 12h6M0 24h4M0 36h6M0 48h4M0 60h6M0 72h4M0 84h6" stroke="currentColor" stroke-width="0.6" />
  <circle cx="50" cy="38" r="15" fill="none" stroke="currentColor" stroke-width="1.2" />
  <path d="M22 86c3-16 14-24 28-24s25 8 28 24" fill="none" stroke="currentColor" stroke-width="1.2" />
</svg>

<style>
  .pp {
    flex: none;
    color: var(--navy);
    background: var(--panel);
  }
</style>
