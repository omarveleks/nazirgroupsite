---
// Neutral line-art portrait placeholder for people without a supplied photograph.
interface Props {
  size?: number;
}
const { size = 96 } = Astro.props;
---
<svg class="pp" viewBox="0 0 96 96" width={size} height={size} aria-hidden="true" focusable="false">
  <circle cx="48" cy="38" r="14" fill="none" stroke="currentColor" stroke-width="1.2" />
  <path d="M20 84c3-15 14-23 28-23s25 8 28 23" fill="none" stroke="currentColor" stroke-width="1.2" />
</svg>

<style>
  .pp {
    flex: none;
    display: block;
    color: #8b96a1;
    background: var(--soft);
  }
</style>
