---
// Engineering strength: leadership, recruitment and network (replaces the named engineers list).
import { company } from '../lib/data';
---
<ol class="list-num strength">
  {company.engineering_strength.points.map(([t, x]) => (
    <li><div><h3>{t}</h3><p>{x}</p></div></li>
  ))}
</ol>
<style>
  .strength h3 {
    font: 400 1.375rem/1.2 var(--display);
  }
  .strength p {
    margin: 0.5rem 0 0;
    font: 300 1rem/1.6 var(--body);
    color: var(--grey);
  }
</style>
