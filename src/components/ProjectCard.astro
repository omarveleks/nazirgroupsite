---
// Tall rounded photo card: light-blue tag, title and a round arrow. The photo is a
// general illustration of the type of work, never presented as the project itself.
import Img from './Img.astro';
import Icon from './Icon.astro';
import type { Slide } from '../lib/site';

interface Props {
  item: Slide & { sub?: string };
  sizes?: string;
  level?: 'h2' | 'h3';
}
// the card is min(80vw, 30rem) wide in rows, so 30rem from 600 px up. On phones the hint
// is 45vw: 3x screens still get the 900 px file, lower-density ones the 480 px file, which
// keeps the rows of cards from delaying first paint on /projects/ (Lighthouse LCP)
const { item, sizes = '(min-width: 37.5em) 30rem, 45vw', level = 'h3' } = Astro.props;
const H = level;
---
<a class="pc" href={item.href}>
  <Img name={item.photo} sizes={sizes} />
  <div class="pc-t">
    <div>
      <span class="tag">{item.tag}</span>
      <H>{item.title}</H>
      {item.sub && <span class="pc-sub">{item.sub}</span>}
    </div>
    <span class="go go--up" aria-hidden="true"><span class="go-i"><Icon name="up-right" /></span></span>
  </div>
</a>
