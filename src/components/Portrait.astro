---
// Portrait photograph (4:5) from public/images/people, generated by scripts/images.mjs.
import images from '../data/images.json';

interface Props {
  name: string;
  alt: string;
  /** Rendered width in CSS px */
  width: number;
  eager?: boolean;
}
const { name, alt, width, eager = false } = Astro.props;
const entry = (images.people as Record<string, { widths: number[] }>)[name];
if (!entry) throw new Error(`No portrait for ${name}`);
const set = (ext: string) => entry.widths.map((w) => `/images/people/${name}-${w}.${ext} ${w}w`).join(', ');
const height = Math.round((width * 5) / 4);
const sizes = `${width}px`;
---
<picture class="portrait">
  <source type="image/avif" srcset={set('avif')} sizes={sizes} />
  <source type="image/webp" srcset={set('webp')} sizes={sizes} />
  <img
    src={`/images/people/${name}-${entry.widths[0]}.jpg`}
    srcset={set('jpg')}
    sizes={sizes}
    width={width}
    height={height}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
</picture>

<style>
  .portrait {
    flex: none;
    display: block;
  }
  .portrait img {
    display: block;
    border: 1px solid var(--navy);
    padding: 3px;
    background: var(--paper);
    height: auto;
  }
</style>
