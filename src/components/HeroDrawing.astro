---
import { heroGeometry } from '../lib/tower';

interface Props {
  class?: string;
  labels?: boolean;
}
const { class: cls = '', labels = true } = Astro.props;
const g = heroGeometry();
const t0 = g.towers[0]!;
---
<svg
  class={`hero-drawing ${cls}`}
  viewBox="0 0 640 440"
  width="640"
  height="440"
  role="img"
  aria-labelledby="hero-drawing-title"
  xmlns="http://www.w3.org/2000/svg"
>
  <title id="hero-drawing-title">Line drawing of a 220 kV double-circuit lattice tower with conductors running to further towers</title>
  <g fill="none" stroke-linecap="round" stroke-linejoin="round">
    <path d={g.ground} stroke="var(--rule-strong, #8e8778)" stroke-width="0.8" />
    <path d={g.wires} stroke="var(--navy, #0b1f3a)" stroke-width="0.9" opacity="0.85" />
    {g.towers.map((t, i) => (
      <g stroke="var(--navy, #0b1f3a)" stroke-width={i === 0 ? 1.1 : 0.8}>
        <path d={t.body} />
        <path d={t.insulators} stroke-width={i === 0 ? 1.4 : 0.8} />
      </g>
    ))}
  </g>
  {labels && (
    <g class="annot" font-family="IBM Plex Mono, Plex Mono Fallback, monospace" font-size="11" fill="var(--navy, #0b1f3a)">
      <path d={`M${t0.base.x + 70} ${t0.attach[4]!.y}H${t0.base.x + 118}`} stroke="var(--amber, #e0a100)" stroke-width="1.2" />
      <circle cx={t0.base.x + 66} cy={t0.attach[4]!.y} r="2.2" fill="var(--amber, #e0a100)" />
      <text x={t0.base.x + 122} y={t0.attach[4]!.y + 4}>220 kV D/C</text>
      <path d={`M24 ${g.groundY + 22}H616`} stroke="var(--navy, #0b1f3a)" stroke-width="0.8" />
      <path d={`M24 ${g.groundY + 16}v12M616 ${g.groundY + 16}v12`} stroke="var(--navy, #0b1f3a)" stroke-width="0.8" />
      <text x="24" y={g.groundY + 8} fill="var(--muted, #5b6773)">BENGHAZI</text>
      <text x="616" y={g.groundY + 8} text-anchor="end" fill="var(--muted, #5b6773)">EASTERN BORDER</text>
      <rect x="282" y={g.groundY + 14} width="76" height="16" fill="var(--paper, #f6f3ec)" />
      <text x="320" y={g.groundY + 26} text-anchor="middle" font-weight="500">750 km</text>
    </g>
  )}
</svg>

<style>
  .hero-drawing {
    display: block;
    width: 100%;
    height: auto;
    animation: hero-fade 600ms ease-out both;
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-drawing {
      animation: none;
    }
  }
</style>
