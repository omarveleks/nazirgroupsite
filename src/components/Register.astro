---
/**
 * Project register: a full server-rendered table (works without JavaScript),
 * enhanced by src/scripts/register.ts with filters and a live count.
 * On narrow screens each row becomes a stacked card.
 */
import type { Project } from '../lib/data';
import {
  SECTOR_LABEL,
  VOLTAGE_BANDS,
  fmtKm,
  fmtKv,
  projectUrl,
  voltageBand,
  clientCanon,
} from '../lib/data';

interface Group {
  id: string;
  title?: string;
  projects: Project[];
}
interface Props {
  id: string;
  groups: Group[];
  showCountry?: boolean;
  search?: boolean;
  caption: string;
}
const { id, groups, showCountry = false, search = true, caption } = Astro.props;
const all = groups.flatMap((g) => g.projects);
const uniq = <T,>(xs: T[]) => [...new Set(xs)];
const sectors = uniq(all.map((p) => p.sector)).sort((a, b) => SECTOR_LABEL[a].localeCompare(SECTOR_LABEL[b]));
const bands = Object.keys(VOLTAGE_BANDS).filter((b) => all.some((p) => voltageBand(p) === b));
const clients = uniq(all.flatMap((p) => p.client.split(' / ').map(clientCanon))).sort((a, b) => a.localeCompare(b));
const countries = uniq(all.map((p) => p.country)).sort();
const norm = (s: string) => s.toLowerCase().replace(/[–—-]/g, ' ');
---
<div class="register" data-register={id}>
  <div class="filters" data-filters role="group" aria-label="Filter projects">
    {search && (
      <div class="f f--search">
        <label for={`${id}-q`}>Search</label>
        <input id={`${id}-q`} name="q" type="search" autocomplete="off" inputmode="search" placeholder="Place, client or kV" />
      </div>
    )}
    {showCountry && countries.length > 1 && (
      <div class="f">
        <label for={`${id}-country`}>Country</label>
        <select id={`${id}-country`} name="country">
          <option value="">All countries</option>
          {countries.map((c) => <option value={c}>{c}</option>)}
        </select>
      </div>
    )}
    <div class="f">
      <label for={`${id}-sector`}>Sector</label>
      <select id={`${id}-sector`} name="sector">
        <option value="">All sectors</option>
        {sectors.map((s) => <option value={s}>{SECTOR_LABEL[s]}</option>)}
      </select>
    </div>
    <div class="f">
      <label for={`${id}-band`}>Voltage</label>
      <select id={`${id}-band`} name="band">
        <option value="">All voltages</option>
        {bands.map((b) => <option value={b}>{VOLTAGE_BANDS[b]}</option>)}
      </select>
    </div>
    <div class="f">
      <label for={`${id}-client`}>Client</label>
      <select id={`${id}-client`} name="client">
        <option value="">All clients</option>
        {clients.map((c) => <option value={c}>{c}</option>)}
      </select>
    </div>
    <div class="f f--reset">
      <button type="button" data-reset>Clear filters</button>
    </div>
  </div>
  <p class="count" aria-live="polite" data-count>
    <span class="fig" data-shown>{all.length}</span> of <span class="fig">{all.length}</span> projects shown
  </p>

  {groups.map((g) => (
    <section class="group" data-group aria-labelledby={g.title ? `${id}-${g.id}` : undefined}>
      {g.title && (
        <h2 class="group-h" id={`${id}-${g.id}`}>
          {g.title} <span class="group-n fig" data-group-count>({g.projects.length})</span>
        </h2>
      )}
      <table class="reg">
        <caption class="visually-hidden">{caption}{g.title ? `: ${g.title}` : ''}</caption>
        <thead>
          <tr>
            <th scope="col">Project</th>
            {showCountry && <th scope="col">Country</th>}
            <th scope="col">Client</th>
            <th scope="col" class="num">kV</th>
            <th scope="col" class="num">km</th>
            <th scope="col">Sector</th>
          </tr>
        </thead>
        <tbody>
          {g.projects.map((p) => (
            <tr
              data-sector={p.sector}
              data-band={voltageBand(p)}
              data-client={p.client.split(' / ').map(clientCanon).join('|')}
              data-country={p.country}
              data-text={norm(`${p.name} ${p.client} ${p.country} ${p.region ?? ''} ${p.scope} ${p.voltage_kv ?? ''} kv`)}
            >
              <th scope="row" class="nm"><a href={projectUrl(p)}>{p.name}</a></th>
              {showCountry && <td data-label="Country">{p.country}</td>}
              <td data-label="Client">{p.client}</td>
              <td class="num fig" data-label="kV">{fmtKv(p.voltage_kv, p).replace(' kV DC', ' DC').replace(' kV', '') || '—'}</td>
              <td class="num fig" data-label="km">{fmtKm(p.length_km).replace(' km', '') || '—'}</td>
              <td data-label="Sector">{SECTOR_LABEL[p.sector]}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="empty" data-empty hidden>No projects in this group match the filters.</p>
    </section>
  ))}
</div>

<script src="../scripts/register.ts"></script>

<style is:global>
  /* global (no scoping attributes on the 187 rows) but every rule sits under .register */
  .register {
    container-type: inline-size;
  }
  .register .filters {
    display: grid;
    gap: 1.25rem 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr));
    align-items: end;
    padding: 0 0 2rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  @media (scripting: none) {
    .register .filters,
    .register .count {
      display: none;
    }
  }
  .register .f {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }
  .register .f--search {
    grid-column: 1 / -1;
  }
  @media (min-width: 60em) {
    .register .filters {
      grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    }
    .register .f--search {
      grid-column: span 2;
    }
  }
  .register .f label {
    font: 600 0.75rem/1.3 var(--display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .register .f input,
  .register .f select {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    background: #fff;
    color: var(--ink);
    font: 300 1rem/1.3 var(--body);
  }
  .register .f input:focus,
  .register .f select:focus {
    outline: none;
    border-color: var(--blue);
    box-shadow: 0 0 0 3px var(--tint);
  }
  .register .f--reset button {
    min-height: 3.25rem;
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: #fff;
    color: var(--ink);
    font: 500 0.9375rem/1 var(--body);
    cursor: pointer;
  }
  .register .f--reset button:hover {
    border-color: var(--ink);
  }
  .register .count {
    margin: 0 0 1.5rem;
    font-size: 0.9375rem;
    color: var(--grey);
  }
  .register .count .fig {
    color: var(--ink);
    font-weight: 500;
  }
  .register .group + .group {
    margin-top: 4rem;
  }
  .register .group-h {
    margin-bottom: 1.25rem;
    font: 300 clamp(1.5rem, 2.4vw, 2.25rem) / 1.15 var(--display);
  }
  .register .group-n {
    font-size: 0.7em;
    color: var(--grey);
  }
  .register .reg {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.45;
  }
  .register .reg th,
  .register .reg td {
    text-align: left;
    vertical-align: top;
    padding: 1rem 0.75rem;
    border-bottom: 1px solid var(--line);
  }
  .register .reg th:first-child,
  .register .reg td:first-child {
    padding-left: 0;
  }
  .register .reg thead th {
    font: 600 0.75rem/1.3 var(--display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--grey);
    border-bottom: 1px solid var(--ink);
    white-space: nowrap;
  }
  .register .reg .num {
    text-align: right;
    white-space: nowrap;
  }
  .register .reg .yr {
    white-space: nowrap;
  }
  .register .reg .nm {
    font: 400 1.0625rem/1.35 var(--display);
    overflow-wrap: anywhere;
  }
  .register .reg .nm a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.25em;
  }
  .register .reg .nm a:hover {
    text-decoration-color: var(--blue);
  }
  .register .reg tbody tr:hover {
    background: var(--tint);
  }
  .register .reg tr[hidden] {
    display: none;
  }
  .register .empty {
    color: var(--grey);
  }

  /* Stacked cards on phones (and whenever the register is narrow, e.g. at 200% text) */
  @container (max-width: 47.99rem) {
    .register .reg thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .register .reg,
    .register .reg tbody,
    .register .reg tr,
    .register .reg th,
    .register .reg td {
      display: block;
      width: 100%;
    }
    .register .reg tr {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1rem;
      margin-bottom: 0.875rem;
      padding: 1.125rem 1.25rem 1rem;
      border: 1px solid var(--line);
      border-radius: var(--r);
      background: #fff;
    }
    .register .reg th,
    .register .reg td,
    .register .reg th:first-child,
    .register .reg td:first-child {
      border: 0;
      padding: 0.3rem 0;
      text-align: left;
    }
    .register .reg .nm {
      grid-column: 1 / -1;
      order: -1;
      padding-bottom: 0.5rem;
    }
    .register .reg .num {
      text-align: left;
    }
    .register .reg td::before {
      content: attr(data-label);
      display: block;
      font: 600 0.6875rem/1.3 var(--display);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--grey);
    }
    .register .reg tr[hidden] {
      display: none;
    }
  }
</style>
