---
/**
 * Project register: a full server-rendered table (works without JavaScript),
 * enhanced by src/scripts/register.ts with filters and a live count.
 * On narrow screens each row becomes a stacked card.
 */
import type { Project } from '../lib/data';
import {
  SECTOR_LABEL,
  VOLTAGE_BANDS,
  decade,
  fmtKm,
  fmtKv,
  projectUrl,
  voltageBand,
  yearText,
  clientCanon,
} from '../lib/data';

interface Group {
  id: string;
  title?: string;
  projects: Project[];
}
interface Props {
  id: string;
  groups: Group[];
  showCountry?: boolean;
  search?: boolean;
  caption: string;
}
const { id, groups, showCountry = false, search = true, caption } = Astro.props;
const all = groups.flatMap((g) => g.projects);
const uniq = <T,>(xs: T[]) => [...new Set(xs)];
const sectors = uniq(all.map((p) => p.sector)).sort((a, b) => SECTOR_LABEL[a].localeCompare(SECTOR_LABEL[b]));
const bands = Object.keys(VOLTAGE_BANDS).filter((b) => all.some((p) => voltageBand(p) === b));
const decades = uniq(all.map(decade)).filter((d) => d !== 'na').sort().reverse();
const hasUndated = all.some((p) => decade(p) === 'na');
const clients = uniq(all.flatMap((p) => p.client.split(' / ').map(clientCanon))).sort((a, b) => a.localeCompare(b));
const countries = uniq(all.map((p) => p.country)).sort();
const norm = (s: string) => s.toLowerCase().replace(/[–—-]/g, ' ');
---
<div class="register" data-register={id}>
  <div class="filters" data-filters role="group" aria-label="Filter projects">
    {search && (
      <div class="f f--search">
        <label for={`${id}-q`}>Search</label>
        <input id={`${id}-q`} name="q" type="search" autocomplete="off" inputmode="search" placeholder="Place, client or kV" />
      </div>
    )}
    {showCountry && countries.length > 1 && (
      <div class="f">
        <label for={`${id}-country`}>Country</label>
        <select id={`${id}-country`} name="country">
          <option value="">All countries</option>
          {countries.map((c) => <option value={c}>{c}</option>)}
        </select>
      </div>
    )}
    <div class="f">
      <label for={`${id}-sector`}>Sector</label>
      <select id={`${id}-sector`} name="sector">
        <option value="">All sectors</option>
        {sectors.map((s) => <option value={s}>{SECTOR_LABEL[s]}</option>)}
      </select>
    </div>
    <div class="f">
      <label for={`${id}-band`}>Voltage</label>
      <select id={`${id}-band`} name="band">
        <option value="">All voltages</option>
        {bands.map((b) => <option value={b}>{VOLTAGE_BANDS[b]}</option>)}
      </select>
    </div>
    <div class="f">
      <label for={`${id}-client`}>Client</label>
      <select id={`${id}-client`} name="client">
        <option value="">All clients</option>
        {clients.map((c) => <option value={c}>{c}</option>)}
      </select>
    </div>
    <div class="f">
      <label for={`${id}-decade`}>Decade</label>
      <select id={`${id}-decade`} name="decade">
        <option value="">All years</option>
        {decades.map((d) => <option value={d}>{d}</option>)}
        {hasUndated && <option value="na">Year not stated</option>}
      </select>
    </div>
    <div class="f f--reset">
      <button type="button" class="btn btn--ghost" data-reset>Clear filters</button>
    </div>
  </div>
  <p class="count" aria-live="polite" data-count>
    <span class="fig" data-shown>{all.length}</span> of <span class="fig">{all.length}</span> projects shown
  </p>

  {groups.map((g) => (
    <section class="group" data-group aria-labelledby={g.title ? `${id}-${g.id}` : undefined}>
      {g.title && (
        <h2 class="group-h" id={`${id}-${g.id}`}>
          {g.title} <span class="group-n fig" data-group-count>({g.projects.length})</span>
        </h2>
      )}
      <table class="reg">
        <caption class="visually-hidden">{caption}{g.title ? `: ${g.title}` : ''}</caption>
        <thead>
          <tr>
            <th scope="col">Year</th>
            <th scope="col">Project</th>
            {showCountry && <th scope="col">Country</th>}
            <th scope="col">Client</th>
            <th scope="col" class="num">kV</th>
            <th scope="col" class="num">km</th>
            <th scope="col">Sector</th>
          </tr>
        </thead>
        <tbody>
          {g.projects.map((p) => (
            <tr
              data-sector={p.sector}
              data-band={voltageBand(p)}
              data-client={p.client.split(' / ').map(clientCanon).join('|')}
              data-decade={decade(p)}
              data-country={p.country}
              data-text={norm(`${p.name} ${p.client} ${p.country} ${p.region ?? ''} ${p.scope} ${p.voltage_kv ?? ''} kv`)}
            >
              <td class="yr fig" data-label="Year">{yearText(p)}</td>
              <th scope="row" class="nm" data-label="Project"><a href={projectUrl(p)}>{p.name}</a></th>
              {showCountry && <td data-label="Country">{p.country}</td>}
              <td data-label="Client">{p.client}</td>
              <td class="num fig" data-label="kV">{fmtKv(p.voltage_kv, p).replace(' kV DC', ' DC').replace(' kV', '') || '—'}</td>
              <td class="num fig" data-label="km">{fmtKm(p.length_km).replace(' km', '') || '—'}</td>
              <td data-label="Sector">{SECTOR_LABEL[p.sector]}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="empty" data-empty hidden>No projects in this group match the filters.</p>
    </section>
  ))}
</div>

<script src="../scripts/register.ts"></script>

<style>
  .register {
    container-type: inline-size;
  }
  .filters {
    display: grid;
    gap: 0.75rem 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 9.5rem), 1fr));
    align-items: end;
    border: 1px solid var(--navy);
    background: var(--panel);
    padding: 1rem;
    margin-bottom: 1rem;
  }
  @media (scripting: none) {
    .filters,
    .count {
      display: none;
    }
  }
  .f {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }
  .f--search {
    grid-column: 1 / -1;
  }
  @media (min-width: 60rem) {
    .filters {
      grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    }
    .f--search {
      grid-column: span 2;
    }
  }
  .f label {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .f input,
  .f select {
    font: inherit;
    font-size: 1rem;
    min-height: 2.75rem;
    width: 100%;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: #fff;
    color: var(--text);
  }
  .f input:focus,
  .f select:focus {
    border-color: var(--navy);
  }
  .count {
    font-size: var(--step--1);
    color: var(--muted);
    margin: 0 0 1rem;
  }
  .count .fig {
    color: var(--navy);
  }
  .group + .group {
    margin-top: 2.5rem;
  }
  .group-h {
    font-size: var(--step-2);
  }
  .group-n {
    font-size: 0.7em;
    color: var(--muted);
  }
  .reg {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  .reg th,
  .reg td {
    text-align: left;
    vertical-align: top;
    padding: 0.6rem 0.6rem;
    border-bottom: 1px solid var(--rule);
  }
  .reg thead th {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--navy);
    white-space: nowrap;
  }
  .reg .num {
    text-align: right;
    white-space: nowrap;
  }
  .reg .yr {
    white-space: nowrap;
  }
  .reg .nm {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .reg tbody tr:hover {
    background: rgba(224, 161, 0, 0.08);
  }
  .reg tr[hidden] {
    display: none;
  }
  .empty {
    color: var(--muted);
    font-style: italic;
  }

  /* Stacked cards on phones (and whenever the register is narrow, e.g. at 200% text) */
  @container (max-width: 47.99rem) {
    .reg thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .reg,
    .reg tbody,
    .reg tr,
    .reg th,
    .reg td {
      display: block;
      width: 100%;
    }
    .reg tr {
      border: 1px solid var(--navy);
      background: var(--panel);
      margin-bottom: 0.75rem;
      padding: 0.5rem 0.75rem 0.6rem;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1rem;
    }
    .reg th,
    .reg td {
      border: 0;
      padding: 0.2rem 0;
      text-align: left;
    }
    .reg .nm {
      grid-column: 1 / -1;
      order: -1;
      font-size: 1.0625rem;
      padding-bottom: 0.3rem;
    }
    .reg .num {
      text-align: left;
    }
    .reg td::before {
      content: attr(data-label);
      display: block;
      font-family: var(--mono);
      font-size: 0.6875rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--muted);
    }
    .reg tr[hidden] {
      display: none;
    }
  }
</style>
