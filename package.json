    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.3",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "cspell": "^10.3.6",
    "d3-geo": "^3.1.1",
    "html-validate": "^11.16.1",
    "lighthouse": "^13.5.0",
    "node-html-parser": "^9.0.4",
    "pdf-lib": "^1.17.1",
    "playwright": "1.56.1",
