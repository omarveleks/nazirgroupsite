  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "build:review": "SITE_MODE=review npm run build",
    "build:live": "SITE_MODE=live npm run build",
    "check": "astro check",
