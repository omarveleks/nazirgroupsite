# Build-time (Cloudflare Pages > Settings > Environment variables)
SITE_MODE=review                      # review | live
PUBLIC_SITE_URL=https://nazir-and-company.pages.dev
PUBLIC_FORM_ENABLED=false             # true once MAIL_TO and MAIL_API_KEY are set
PUBLIC_TURNSTILE_SITE_KEY=            # Cloudflare Turnstile site key

# Runtime secrets for the contact function (never commit real values)
MAIL_PROVIDER=resend                  # resend | sendgrid | postmark
MAIL_API_KEY=
MAIL_TO=
MAIL_FROM=
TURNSTILE_SECRET_KEY=
